.{
    .id = "dev.petdex.desktop-native",
    .name = "petdex-desktop-native",
    .display_name = "Petdex",
    .description = "Petdex desktop pet on Native SDK: no WebView, no Node.",
    .version = "0.5.0",
    .icons = .{"assets/icon.png"},
    .platforms = .{ "macos", "windows", "linux" },
    .permissions = .{ "view", "command" },
    .capabilities = .{ "native_views", "gpu_surfaces", "menus", "url_schemes", "tray" },
    // petdex.dev links straight into a running app (`petdex://<slug>`
    // swaps the active pet). Without the declaration macOS has no owner
    // for the scheme and the link dies before reaching the app, which is
    // why the site's button always fell through to /download.
    .url_schemes = .{
        .{ .scheme = "petdex" },
    },
    .menus = .{
        .{
            .title = "Pet",
            .items = .{
                .{ .label = "Settings...", .command = "petdex.settings", .key = ",", .modifiers = .{"primary"} },
                .{ .label = "Close Pet", .command = "petdex.close", .key = "w", .modifiers = .{"primary"} },
            },
        },
    },
    .shell = .{
        .windows = .{
            .{
                .label = "main",
                .title = "Petdex",
                .width = 231,
                .height = 250,
                .resizable = false,
                .titlebar = "chromeless",
                .floating = true,
                .transparent = true,
                .restore_state = false,
                .restore_policy = "center_on_primary",
                .views = .{
                    .{ .label = "pet-canvas", .kind = "gpu_surface", .fill = true, .role = "Pet canvas", .accessibility_label = "Petdex pet", .gpu_backend = "metal", .gpu_pixel_format = "bgra8_unorm", .gpu_present_mode = "timer", .gpu_alpha_mode = "premultiplied", .gpu_color_space = "srgb", .gpu_vsync = true },
                },
            },
        },
    },
    .security = .{
        .navigation = .{
            .allowed_origins = .{ "zero://app", "zero://inline" },
            .external_links = .{ .action = "deny" },
        },
    },
    .web_engine = "system",
}
