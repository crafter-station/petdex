# Petdex Discord Bot env
# https://discord.com/developers/applications/1501142945909440592/bot

DISCORD_TOKEN=
DISCORD_CLIENT_ID=1501142945909440592
# Required for `bun run register`, and scopes announcements to this guild. Left
# blank, the webhook posts into whichever guild the bot is in that holds the
# first channel named `showcase` (a second-guild invite would redirect them).
DISCORD_GUILD_ID=
# Webhook secret shared with petdex.dev for /api/discord/webhook
PETDEX_WEBHOOK_SECRET=
PETDEX_API_BASE=https://petdex.dev
