#!/bin/sh
set -eu

root=$(git rev-parse --show-toplevel)
cd "$root"

if command -v bun >/dev/null 2>&1; then
    bun_bin=$(command -v bun)
elif [ -x "$HOME/.bun/bin/bun" ]; then
    bun_bin=$HOME/.bun/bin/bun
else
    echo "pre-commit: Bun is required (https://bun.sh/docs/installation)" >&2
    exit 1
fi

"$bun_bin" run check

zig_files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.zig')
if [ -n "$zig_files" ]; then
    command -v zig >/dev/null 2>&1 || {
        echo "pre-commit: Zig is required to check native sources" >&2
        exit 1
    }
    printf '%s\n' "$zig_files" | while IFS= read -r file; do
        zig fmt --check "$file"
    done
fi

shell_files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.sh')
if [ -n "$shell_files" ]; then
    printf '%s\n' "$shell_files" | while IFS= read -r file; do
        /bin/sh -n "$file"
    done
fi

python_files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.py')
if [ -n "$python_files" ]; then
    command -v python3 >/dev/null 2>&1 || {
        echo "pre-commit: Python 3 is required to check Python sources" >&2
        exit 1
    }
    printf '%s\n' "$python_files" | while IFS= read -r file; do
        python3 -c 'import ast, pathlib, sys; path = pathlib.Path(sys.argv[1]); ast.parse(path.read_text(encoding="utf-8"), filename=str(path))' "$file"
    done
fi

/bin/sh -n "$0"

git diff --check --cached
