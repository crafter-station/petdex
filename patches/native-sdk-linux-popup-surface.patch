+/* Turn the complete rendered RGBA frame into a logical-pixel input shape.
+ * The canvas is the authority for both visible controls and transparent
+ * margins, so this remains correct as app layouts and display scales change.
+ * A low nonzero threshold includes antialiased rounded edges without making
+ * fully transparent window padding intercept input. */
+static void native_sdk_popup_apply_alpha_input_region(native_sdk_gtk_window_t *win) {
+    if (!win || !win->popup || !win->alpha_shaped_input) return;
+    GdkSurface *surface = native_sdk_widget_surface(win->popup);
+    if (!surface) return;
+    cairo_region_t *region = cairo_region_create();
+    if (!region) return;
+
+    for (int view_index = 0; view_index < NATIVE_SDK_MAX_NATIVE_VIEWS; view_index++) {
+        native_sdk_gtk_native_view_t *view = &win->native_views[view_index];
+        if (view->kind != NATIVE_SDK_GTK_VIEW_GPU_SURFACE || !view->visible ||
+            !view->gpu_argb || view->gpu_buf_width <= 0 || view->gpu_buf_height <= 0)
+            continue;
+
+        const int logical_width = gtk_widget_get_width(view->widget);
+        const int logical_height = gtk_widget_get_height(view->widget);
+        const int origin_x = (int)floor(view->x);
+        const int origin_y = (int)floor(view->y);
+        if (logical_width <= 0 || logical_height <= 0) continue;
+
+        for (int logical_y = 0; logical_y < logical_height; logical_y++) {
+            const size_t pixel_y0 = (size_t)logical_y * (size_t)view->gpu_buf_height / (size_t)logical_height;
+            size_t pixel_y1 = (size_t)(logical_y + 1) * (size_t)view->gpu_buf_height / (size_t)logical_height;
+            if (pixel_y1 <= pixel_y0) pixel_y1 = pixel_y0 + 1;
+            if (pixel_y1 > (size_t)view->gpu_buf_height) pixel_y1 = (size_t)view->gpu_buf_height;
+            int run_start = -1;
+            for (int logical_x = 0; logical_x <= logical_width; logical_x++) {
+                int opaque = 0;
+                if (logical_x < logical_width) {
+                    const size_t pixel_x0 = (size_t)logical_x * (size_t)view->gpu_buf_width / (size_t)logical_width;
+                    size_t pixel_x1 = (size_t)(logical_x + 1) * (size_t)view->gpu_buf_width / (size_t)logical_width;
+                    if (pixel_x1 <= pixel_x0) pixel_x1 = pixel_x0 + 1;
+                    if (pixel_x1 > (size_t)view->gpu_buf_width) pixel_x1 = (size_t)view->gpu_buf_width;
+                    for (size_t pixel_y = pixel_y0; pixel_y < pixel_y1 && !opaque; pixel_y++) {
+                        const uint32_t *row = (const uint32_t *)(view->gpu_argb + pixel_y * (size_t)view->gpu_buf_stride);
+                        for (size_t pixel_x = pixel_x0; pixel_x < pixel_x1; pixel_x++) {
+                            if ((row[pixel_x] >> 24) >= 8) {
+                                opaque = 1;
+                                break;
+                            }
+                        }
+                    }
+                }
+                if (opaque && run_start < 0) run_start = logical_x;
+                if (!opaque && run_start >= 0) {
+                    const cairo_rectangle_int_t rect = {
+                        .x = origin_x + run_start,
+                        .y = origin_y + logical_y,
+                        .width = logical_x - run_start,
+                        .height = 1,
+                    };
+                    cairo_region_union_rectangle(region, &rect);
+                    run_start = -1;
+                }
+            }
+        }
