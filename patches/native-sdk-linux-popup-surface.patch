+/* KWin can finish managing a newly mapped client after GTK's `map`
+ * signal. In that ordering the immediate ABOVE message is recorded, but
+ * the first stacking decision can still leave the companion underneath
+ * the window that was active while it launched. AppKit's bit-3 companion
+ * panel has a stronger, non-activating screen overlay level, so retry the
+ * standard X11 request once the WM has had a turn and ask it to restack
+ * the already-managed client. Neither request activates the window or
+ * changes the user's keyboard focus.
+ *
+ * XRaiseWindow is a compatibility fallback for window managers that do
+ * not implement _NET_RESTACK_WINDOW. On a managed client it becomes a
+ * ConfigureRequest to the WM; on a bare X server it raises directly. */
+static gboolean native_sdk_window_restack_x11_overlay(gpointer data) {
+    GtkWidget *widget = GTK_WIDGET(data);
+    if (!widget || !gtk_widget_get_mapped(widget)) return G_SOURCE_REMOVE;
+
+    native_sdk_window_request_x11_above(widget, NULL);
+
+    GdkSurface *surface = gtk_native_get_surface(GTK_NATIVE(widget));
+    if (!surface || !GDK_IS_X11_SURFACE(surface)) return G_SOURCE_REMOVE;
+    GdkDisplay *display = gdk_surface_get_display(surface);
+    if (!display || !GDK_IS_X11_DISPLAY(display)) return G_SOURCE_REMOVE;
+
+    Display *xdisplay = GDK_DISPLAY_XDISPLAY(display);
+    Window xid = GDK_SURFACE_XID(surface);
+    if (!xdisplay || xid == None) return G_SOURCE_REMOVE;
+
+    Atom net_restack = gdk_x11_get_xatom_by_name_for_display(display, "_NET_RESTACK_WINDOW");
+    if (net_restack != None) {
+        XEvent event;
+        memset(&event, 0, sizeof(event));
+        event.xclient.type = ClientMessage;
+        event.xclient.display = xdisplay;
+        event.xclient.window = xid;
+        event.xclient.message_type = net_restack;
+        event.xclient.format = 32;
+        event.xclient.data.l[0] = 1; /* normal application */
+        event.xclient.data.l[1] = (long)None; /* no sibling */
+        event.xclient.data.l[2] = Above;
+        XSendEvent(xdisplay, DefaultRootWindow(xdisplay), False,
+                   SubstructureRedirectMask | SubstructureNotifyMask, &event);
+    }
+    XRaiseWindow(xdisplay, xid);
+    XFlush(xdisplay);
+    return G_SOURCE_REMOVE;
+}
+
+static void native_sdk_window_schedule_x11_overlay_restack(GtkWidget *widget, gpointer data) {
+    (void)data;
