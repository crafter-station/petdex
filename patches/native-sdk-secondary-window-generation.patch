+test "an opted-in secondary window rebuilds only when its content generation advances" {
+    const fixture = try Fixture.create();
+    defer fixture.destroy();
+
+    try fixture.clickSettingsButton();
+    const info = fixture.settingsWindowInfo() orelse return error.TestUnexpectedResult;
+    try fixture.installSettingsCanvas(info.id);
+
+    fixture.app_state.model.window_content_generation = 7;
+    try fixture.app_state.dispatch(&fixture.harness.runtime, info.id, .bump);
+    var layout = try fixture.harness.runtime.canvasWidgetLayout(info.id, settings_canvas_label);
+    try std.testing.expect(widgetIdByText(layout, .text, "bumped 1") != null);
+
+    // The model changes, but a settled non-zero generation leaves the
+    // companion tree untouched after an unrelated dispatch.
+    try fixture.app_state.dispatch(&fixture.harness.runtime, 1, .bump);
+    try std.testing.expectEqual(@as(u32, 2), fixture.app_state.model.bumps);
+    layout = try fixture.harness.runtime.canvasWidgetLayout(info.id, settings_canvas_label);
+    try std.testing.expect(widgetIdByText(layout, .text, "bumped 1") != null);
+    try std.testing.expect(widgetIdByText(layout, .text, "bumped 2") == null);
+
+    fixture.app_state.model.window_content_generation = 8;
+    try fixture.app_state.dispatch(&fixture.harness.runtime, 1, .bump);
+    layout = try fixture.harness.runtime.canvasWidgetLayout(info.id, settings_canvas_label);
+    try std.testing.expect(widgetIdByText(layout, .text, "bumped 3") != null);
+}
