+                    overlay->card.shimmer_phase += 0.025f;
+                    if (overlay->card.shimmer_phase >= 1) overlay->card.shimmer_phase -= 1;
+                    InvalidateRect(hwnd, nullptr, FALSE);
+                    if (overlay->host->bubble_dcomp_device) overlay->host->bubble_dcomp_device->Commit();
+                } else KillTimer(hwnd, kBubbleShimmerTimerId);
+                return 0;
+            }
+            break;
+        case WM_THEMECHANGED:
+        case WM_SETTINGCHANGE:
+        case WM_SYSCOLORCHANGE:
+        case WM_DWMCOLORIZATIONCOLORCHANGED:
