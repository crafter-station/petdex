+static void applyBubbleBackdrop(BubbleOverlay &overlay) {
+    if (!overlay.hwnd) return;
+    const BubbleGlass *glass = overlay.kind == kBubbleCardOverlay ? &overlay.card.glass :
+        overlay.kind == kBubbleDisclosureOverlay ? &overlay.disclosure.glass : nullptr;
+    const BOOL dark = glass && glass->dark ? TRUE : FALSE;
+    const int corner = kDwmwcRound;
+    /* A translucent full-client backdrop makes failed HWND clipping visible as
+     * square corners. Only enable it after the matching device-pixel region
+     * has been installed successfully. */
+    const int backdrop = overlay.rounded_region_active && bubbleAcrylicEligible(overlay) ? kDwmsbtTransientWindow : kDwmsbtNone;
+    const DwmApi &dwm = dwmApi();
+    if (dwm.set_window_attribute) {
+        (void)dwm.set_window_attribute(overlay.hwnd, kDwmwaUseImmersiveDarkMode, &dark, sizeof(dark));
+        (void)dwm.set_window_attribute(overlay.hwnd, kDwmwaWindowCornerPreference, &corner, sizeof(corner));
+        (void)dwm.set_window_attribute(overlay.hwnd, kDwmwaSystemBackdropType, &backdrop, sizeof(backdrop));
+    }
+    MARGINS margins = overlay.rounded_region_active ? MARGINS { -1, -1, -1, -1 } : MARGINS { 0, 0, 0, 0 };
+    (void)DwmExtendFrameIntoClientArea(overlay.hwnd, &margins);
+}
+
+static D2D1_COLOR_F bubbleColor(COLORREF color, float alpha = 1) {
+    return D2D1::ColorF(GetRValue(color) / 255.0f, GetGValue(color) / 255.0f, GetBValue(color) / 255.0f, alpha);
+}
+
+struct BubblePalette {
+    D2D1_COLOR_F surface;
+    D2D1_COLOR_F border;
+    D2D1_COLOR_F title;
+    D2D1_COLOR_F text;
+    D2D1_COLOR_F muted;
+    D2D1_COLOR_F accent;
+};
+
+static BubblePalette bubblePalette(bool dark, bool high_contrast, int state, float alpha) {
+    BubblePalette palette;
+    if (high_contrast || bubbleSystemHighContrast()) {
+        palette.surface = bubbleColor(GetSysColor(COLOR_WINDOW), alpha);
+        palette.border = bubbleColor(GetSysColor(COLOR_WINDOWTEXT), 1);
+        palette.title = bubbleColor(GetSysColor(COLOR_WINDOWTEXT), 1);
+        palette.text = palette.title;
+        palette.muted = palette.title;
+        palette.accent = bubbleColor(GetSysColor(COLOR_HIGHLIGHT), 1);
+        return palette;
+    }
+    palette.surface = dark ? D2D1::ColorF(0x171A20, 0.76f * alpha) : D2D1::ColorF(0xF5F7FB, 0.78f * alpha);
+    palette.border = dark ? D2D1::ColorF(0xFFFFFF, 0.17f * alpha) : D2D1::ColorF(0x465066, 0.22f * alpha);
+    palette.title = dark ? D2D1::ColorF(0xFFFFFF, alpha) : D2D1::ColorF(0x151922, alpha);
+    palette.text = dark ? D2D1::ColorF(0xE4E8F0, 0.92f * alpha) : D2D1::ColorF(0x303744, 0.92f * alpha);
+    palette.muted = dark ? D2D1::ColorF(0xB8C0CF, 0.78f * alpha) : D2D1::ColorF(0x667084, 0.82f * alpha);
+    switch (state) {
+        case 1: palette.accent = D2D1::ColorF(0x4B84FF, alpha); break;
+        case 2: palette.accent = D2D1::ColorF(0xFF9F0A, alpha); break;
+        case 3: palette.accent = D2D1::ColorF(0x34C759, alpha); break;
+        case 4: palette.accent = D2D1::ColorF(0xFF453A, alpha); break;
+        default: palette.accent = palette.muted; break;
+    }
+    return palette;
+}
+
+static ID2D1HwndRenderTarget *bubbleRenderTarget(BubbleOverlay &overlay) {
+    if (overlay.render_target) return overlay.render_target;
+    if (!overlay.host || !overlay.hwnd || !ensureBubbleGraphics(overlay.host)) return nullptr;
+    RECT client = {};
+    GetClientRect(overlay.hwnd, &client);
+    D2D1_RENDER_TARGET_PROPERTIES properties = D2D1::RenderTargetProperties(
+        D2D1_RENDER_TARGET_TYPE_DEFAULT,
+        D2D1::PixelFormat(DXGI_FORMAT_UNKNOWN, D2D1_ALPHA_MODE_PREMULTIPLIED));
+    D2D1_HWND_RENDER_TARGET_PROPERTIES hwnd_properties = D2D1::HwndRenderTargetProperties(
+        overlay.hwnd, D2D1::SizeU((UINT32)std::max<LONG>(1, client.right), (UINT32)std::max<LONG>(1, client.bottom)));
+    if (FAILED(overlay.host->bubble_d2d_factory->CreateHwndRenderTarget(properties, hwnd_properties, &overlay.render_target))) return nullptr;
+    const FLOAT dpi = (FLOAT)dpiForWindow(overlay.hwnd);
+    overlay.render_target->SetDpi(dpi, dpi);
+    return overlay.render_target;
+}
+
+static void bubbleDrawText(BubbleOverlay &overlay, ID2D1RenderTarget *target, const std::string &utf8, BubbleFrame frame,
+                           float size, DWRITE_FONT_WEIGHT weight, D2D1_COLOR_F color, float opacity = 1) {
+    if (utf8.empty() || frame.w <= 0 || frame.h <= 0 || !overlay.host || !overlay.host->bubble_dwrite_factory) return;
+    IDWriteTextFormat *format = nullptr;
+    HRESULT hr = overlay.host->bubble_dwrite_factory->CreateTextFormat(
+        L"Segoe UI Variable Text", nullptr, weight, DWRITE_FONT_STYLE_NORMAL, DWRITE_FONT_STRETCH_NORMAL,
+        std::max(8.0f, size), L"", &format);
+    if (FAILED(hr)) hr = overlay.host->bubble_dwrite_factory->CreateTextFormat(
+        L"Segoe UI", nullptr, weight, DWRITE_FONT_STYLE_NORMAL, DWRITE_FONT_STRETCH_NORMAL,
+        std::max(8.0f, size), L"", &format);
+    if (FAILED(hr) || !format) return;
+    format->SetWordWrapping(DWRITE_WORD_WRAPPING_NO_WRAP);
+    format->SetParagraphAlignment(DWRITE_PARAGRAPH_ALIGNMENT_NEAR);
+    ID2D1SolidColorBrush *brush = nullptr;
+    color.a *= opacity;
+    if (SUCCEEDED(target->CreateSolidColorBrush(color, &brush)) && brush) {
+        std::wstring text = widen(utf8);
+        target->DrawText(text.c_str(), (UINT32)text.size(), format,
+            D2D1::RectF(frame.x, frame.y, frame.x + frame.w, frame.y + frame.h), brush,
+            D2D1_DRAW_TEXT_OPTIONS_CLIP, DWRITE_MEASURING_MODE_NATURAL);
+        brush->Release();
+    }
+    format->Release();
+}
+
+static void bubbleDrawShimmerText(BubbleOverlay &overlay, ID2D1RenderTarget *target, const BubbleLine &line,
+                                  float size, const BubblePalette &palette) {
+    if (!overlay.card.busy || overlay.card.reduce_motion || line.text.empty()) return;
+    const float phase = overlay.card.shimmer_phase - std::floor(overlay.card.shimmer_phase);
+    const float center = line.frame.x - line.frame.w * 0.35f + phase * line.frame.w * 1.7f;
+    D2D1_GRADIENT_STOP stops[] = {
+        { 0.0f, D2D1::ColorF(palette.text.r, palette.text.g, palette.text.b, 0.0f) },
+        { 0.5f, D2D1::ColorF(1, 1, 1, 0.75f) },
+        { 1.0f, D2D1::ColorF(palette.text.r, palette.text.g, palette.text.b, 0.0f) },
+    };
+    ID2D1GradientStopCollection *collection = nullptr;
+    ID2D1LinearGradientBrush *brush = nullptr;
+    if (FAILED(target->CreateGradientStopCollection(stops, 3, &collection)) || !collection) return;
+    if (SUCCEEDED(target->CreateLinearGradientBrush(
+            D2D1::LinearGradientBrushProperties(D2D1::Point2F(center - line.frame.w * 0.22f, 0), D2D1::Point2F(center + line.frame.w * 0.22f, 0)),
+            collection, &brush)) && brush) {
+        IDWriteTextFormat *format = nullptr;
+        if (SUCCEEDED(overlay.host->bubble_dwrite_factory->CreateTextFormat(
+                L"Segoe UI Variable Text", nullptr, DWRITE_FONT_WEIGHT_NORMAL, DWRITE_FONT_STYLE_NORMAL,
+                DWRITE_FONT_STRETCH_NORMAL, std::max(8.0f, size), L"", &format)) && format) {
+            format->SetWordWrapping(DWRITE_WORD_WRAPPING_NO_WRAP);
+            std::wstring text = widen(line.text);
+            target->DrawText(text.c_str(), (UINT32)text.size(), format,
+                D2D1::RectF(line.frame.x, line.frame.y, line.frame.x + line.frame.w, line.frame.y + line.frame.h),
+                brush, D2D1_DRAW_TEXT_OPTIONS_CLIP, DWRITE_MEASURING_MODE_NATURAL);
+            format->Release();
+        }
+        brush->Release();
+    }
+    collection->Release();
+}
+
+static void paintBubbleOverlay(BubbleOverlay &overlay) {
+    ID2D1HwndRenderTarget *target = bubbleRenderTarget(overlay);
+    if (!target) return;
+    target->BeginDraw();
+    target->Clear(D2D1::ColorF(0, 0));
+
+    if (overlay.kind == kBubbleCardOverlay) {
+        const BubbleCardPresentation &card = overlay.card;
+        const BubblePalette palette = bubblePalette(card.glass.dark, card.glass.high_contrast, card.glass.state, card.glass.alpha);
+        ID2D1SolidColorBrush *surface = nullptr;
+        ID2D1SolidColorBrush *border = nullptr;
+        if (SUCCEEDED(target->CreateSolidColorBrush(palette.surface, &surface)) && surface) {
+            target->FillRoundedRectangle(D2D1::RoundedRect(D2D1::RectF(0, 0, card.glass.frame.w, card.glass.frame.h), card.glass.radius, card.glass.radius), surface);
+            surface->Release();
+        }
+        if (SUCCEEDED(target->CreateSolidColorBrush(palette.border, &border)) && border) {
+            target->DrawRoundedRectangle(D2D1::RoundedRect(D2D1::RectF(0.5f, 0.5f, card.glass.frame.w - 0.5f, card.glass.frame.h - 0.5f), card.glass.radius, card.glass.radius), border, 1);
+            border->Release();
+        }
+        std::string metadata = card.agent;
+        if (!card.hostname.empty()) metadata += " · " + card.hostname;
+        if (!card.project.empty()) metadata += " · " + card.project;
+        bubbleDrawText(overlay, target, metadata, card.metadata_left_frame, card.metadata_font_size, DWRITE_FONT_WEIGHT_MEDIUM, palette.muted, card.metadata_alpha * card.content_alpha);
+        bubbleDrawText(overlay, target, card.title, card.title_frame, card.title_font_size, DWRITE_FONT_WEIGHT_SEMI_BOLD, palette.title, card.content_alpha);
+        for (const BubbleLine &line : card.messages) {
+            bubbleDrawText(overlay, target, line.text, line.frame, card.message_font_size, DWRITE_FONT_WEIGHT_NORMAL, palette.text, card.content_alpha);
+            bubbleDrawShimmerText(overlay, target, line, card.message_font_size, palette);
+        }
+        for (const BubbleLine &line : card.nested)
+            bubbleDrawText(overlay, target, line.text, line.frame, card.nested_font_size, DWRITE_FONT_WEIGHT_NORMAL, palette.muted, card.nested_alpha * card.content_alpha);
+        if (card.status_frame.w > 0 && card.status_frame.h > 0) {
+            ID2D1SolidColorBrush *status = nullptr;
+            if (SUCCEEDED(target->CreateSolidColorBrush(palette.accent, &status)) && status) {
+                const float radius = std::min(card.status_frame.w, card.status_frame.h) * 0.42f;
+                target->FillEllipse(D2D1::Ellipse(D2D1::Point2F(card.status_frame.x + card.status_frame.w / 2, card.status_frame.y + card.status_frame.h / 2), radius, radius), status);
+                status->Release();
+            }
+        }
+    } else if (overlay.kind == kBubbleDisclosureOverlay) {
+        const BubbleGlass &glass = overlay.disclosure.glass;
+        const BubblePalette palette = bubblePalette(glass.dark, glass.high_contrast, overlay.disclosure.state, overlay.disclosure.alpha);
+        ID2D1SolidColorBrush *surface = nullptr;
+        ID2D1SolidColorBrush *border = nullptr;
+        if (SUCCEEDED(target->CreateSolidColorBrush(palette.surface, &surface)) && surface) {
+            target->FillEllipse(D2D1::Ellipse(D2D1::Point2F(glass.frame.w / 2, glass.frame.h / 2), glass.frame.w / 2, glass.frame.h / 2), surface);
+            surface->Release();
+        }
+        if (SUCCEEDED(target->CreateSolidColorBrush(palette.border, &border)) && border) {
+            target->DrawEllipse(D2D1::Ellipse(D2D1::Point2F(glass.frame.w / 2, glass.frame.h / 2), glass.frame.w / 2 - 0.5f, glass.frame.h / 2 - 0.5f), border, 1);
+            border->Release();
+        }
+    } else {
+        const BubbleControlPresentation &control = overlay.control;
+        const bool dark = bubbleSystemHighContrast() ? false : true;
+        const BubblePalette palette = bubblePalette(dark, bubbleSystemHighContrast(), control.state, control.alpha);
+        ID2D1SolidColorBrush *fill = nullptr;
+        D2D1_COLOR_F fill_color = control.selected ? palette.accent : D2D1::ColorF(palette.surface.r, palette.surface.g, palette.surface.b, control.overlay ? 0.58f : 0.76f);
+        if (SUCCEEDED(target->CreateSolidColorBrush(fill_color, &fill)) && fill) {
+            target->FillRoundedRectangle(D2D1::RoundedRect(D2D1::RectF(0, 0, control.frame.w, control.frame.h), control.frame.h / 2, control.frame.h / 2), fill);
+            fill->Release();
+        }
+        const wchar_t *glyph = L"\uE70D";
+        switch (control.action) {
+            case 1: glyph = L"\uE8A7"; break;
+            case 2: glyph = L"\uE718"; break;
+            case 3: glyph = L"\uE716"; break;
+            case 4: glyph = L"\uE711"; break;
+            default: glyph = control.points_up ? L"\uE70E" : L"\uE70D"; break;
+        }
+        IDWriteTextFormat *format = nullptr;
+        if (SUCCEEDED(overlay.host->bubble_dwrite_factory->CreateTextFormat(L"Segoe Fluent Icons", nullptr,
+                DWRITE_FONT_WEIGHT_NORMAL, DWRITE_FONT_STYLE_NORMAL, DWRITE_FONT_STRETCH_NORMAL, 13, L"", &format)) && format) {
+            format->SetTextAlignment(DWRITE_TEXT_ALIGNMENT_CENTER);
+            format->SetParagraphAlignment(DWRITE_PARAGRAPH_ALIGNMENT_CENTER);
+            ID2D1SolidColorBrush *brush = nullptr;
+            if (SUCCEEDED(target->CreateSolidColorBrush(palette.title, &brush)) && brush) {
+                target->DrawText(glyph, 1, format, D2D1::RectF(0, 0, control.frame.w, control.frame.h), brush);
+                brush->Release();
+            }
+            format->Release();
+        }
+        if (control.badge_count > 0) {
+            char count[8] = {};
+            snprintf(count, sizeof(count), "%d", control.badge_count);
+            bubbleDrawText(overlay, target, count, { 0, 4, control.frame.w, control.frame.h - 4 }, 11, DWRITE_FONT_WEIGHT_SEMI_BOLD, palette.title);
+        }
+    }
+
+    HRESULT result = target->EndDraw();
+    if (result == D2DERR_RECREATE_TARGET) {
+        overlay.render_target->Release();
+        overlay.render_target = nullptr;
+    }
+}
+
+static const wchar_t *bubbleControlAccessibilityName(const BubbleControlPresentation &control) {
+    switch (control.action) {
+        case 0:
+            if (control.mode == 0) return L"Show most recent active session only";
+            if (control.mode == 1) return L"Hide session cards";
+            return L"Show all active sessions";
+        case 1: return L"Open agent session";
+        case 2: return control.selected ? L"Unpin session" : L"Pin session to front";
+        case 3: return control.selected ? L"Collapse subagent messages" : L"Expand subagent messages";
+        case 4: return L"Dismiss ended session";
+        default: return L"Session action";
+    }
+}
+
+static ATOM registerBubbleOverlayClass(Host *host) {
+    WNDCLASSEXW wc = {};
+    wc.cbSize = sizeof(wc);
+    wc.lpfnWndProc = bubbleOverlayProc;
+    wc.hInstance = host->instance;
+    wc.hCursor = LoadCursor(nullptr, IDC_ARROW);
+    wc.hbrBackground = nullptr;
+    wc.lpszClassName = L"NativeSdkPetdexBubbleOverlay";
+    ATOM atom = RegisterClassExW(&wc);
+    if (!atom && GetLastError() == ERROR_CLASS_ALREADY_EXISTS) return 1;
+    return atom;
+}
+
+static void initializeBubbleComposition(BubbleOverlay &overlay) {
+    if (!overlay.host || !overlay.hwnd || !ensureBubbleGraphics(overlay.host) || !overlay.host->bubble_dcomp_device) return;
+    if (FAILED(overlay.host->bubble_dcomp_device->CreateTargetForHwnd(overlay.hwnd, TRUE, &overlay.composition_target)) || !overlay.composition_target) return;
+    if (FAILED(overlay.host->bubble_dcomp_device->CreateVisual(&overlay.root_visual)) || !overlay.root_visual) return;
+    if (SUCCEEDED(overlay.host->bubble_dcomp_device->CreateVisual(&overlay.shimmer_visual)) && overlay.shimmer_visual) {
+        /* The shimmer has its own compositor visual. D2D refreshes only the
+         * glyph mask on the overlay timer; the app's retained canvas frame is
+         * never rebuilt to animate message text. */
+        overlay.root_visual->AddVisual(overlay.shimmer_visual, TRUE, nullptr);
+    }
+    overlay.composition_target->SetRoot(overlay.root_visual);
+    overlay.host->bubble_dcomp_device->Commit();
+}
+
+static BubbleOverlay *createBubbleOverlay(Host *host, uint64_t owner_window_id, const std::string &key, BubbleOverlayKind kind) {
+    auto existing = host->bubble_overlays.find(key);
+    if (existing != host->bubble_overlays.end()) return existing->second.get();
+    const Window *owner = windowForId(host, owner_window_id);
+    if (!owner || !owner->hwnd || !registerBubbleOverlayClass(host)) return nullptr;
+    std::unique_ptr<BubbleOverlay> created(new BubbleOverlay());
+    created->host = host;
+    created->owner_window_id = owner_window_id;
+    created->kind = kind;
+    created->hwnd = CreateWindowExW(
+        WS_EX_NOACTIVATE | WS_EX_TOOLWINDOW,
+        L"NativeSdkPetdexBubbleOverlay", L"Petdex session", WS_POPUP,
+        0, 0, 1, 1, owner->hwnd, nullptr, host->instance, created.get());
+    if (!created->hwnd) return nullptr;
+    initializeBubbleComposition(*created);
+    applyBubbleBackdrop(*created);
+    BubbleOverlay *result = created.get();
+    host->bubble_overlays.emplace(key, std::move(created));
+    return result;
+}
