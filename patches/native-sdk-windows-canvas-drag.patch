+static SIZE windowOuterSizeForContent(const Window &window, double logical_width, double logical_height) {
+    const UINT dpi = dpiForWindow(window.hwnd);
+    const double scale = (double)dpi / 96.0;
+    const double content_width = logical_width * scale;
+    const double content_height = logical_height * scale;
+    const DWORD style = (DWORD)GetWindowLongPtrW(window.hwnd, GWL_STYLE);
+    const DWORD ex_style = (DWORD)GetWindowLongPtrW(window.hwnd, GWL_EXSTYLE);
+    const bool has_menu = GetMenu(window.hwnd) != nullptr;
+    RECT frame = { 0, 0, physicalContentExtent(content_width), physicalContentExtent(content_height) };
+    adjustWindowRectForDpi(&frame, style, has_menu ? TRUE : FALSE, ex_style, dpi);
+    SIZE outer = { frame.right - frame.left, frame.bottom - frame.top };
+    if (windowUsesHiddenTitlebar(window)) {
+        outer = hiddenOuterSizeForContent(style, ex_style, has_menu, content_width, content_height, dpi);
+    }
+    return outer;
