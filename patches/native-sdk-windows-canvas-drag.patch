+            return 0;
+        case WM_KEYDOWN:
+            if (overlay && (wparam == VK_SPACE || wparam == VK_RETURN)) {
+                if (overlay->kind == kBubbleCardOverlay && overlay->card.action_available) emitBubbleNativeCommand(*overlay, "card", "activate");
+                else if (overlay->kind == kBubbleControlOverlay) emitBubbleControlCommand(*overlay);
+                return 0;
+            }
+            break;
