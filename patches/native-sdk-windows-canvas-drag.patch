+HRESULT BubbleUiaRootProvider::QueryInterface(REFIID iid, void **out) {
+    if (!out) return E_INVALIDARG;
+    *out = nullptr;
+    if (iid == IID_IUnknown || iid == IID_IRawElementProviderSimple) *out = static_cast<IRawElementProviderSimple *>(this);
+    else if (iid == IID_IRawElementProviderFragment) *out = static_cast<IRawElementProviderFragment *>(this);
+    else if (iid == IID_IRawElementProviderFragmentRoot) *out = static_cast<IRawElementProviderFragmentRoot *>(this);
+    else return E_NOINTERFACE;
+    AddRef();
+    return S_OK;
+}
+HRESULT BubbleUiaRootProvider::get_ProviderOptions(ProviderOptions *options) {
+    if (!options) return E_INVALIDARG;
+    *options = ProviderOptions_ServerSideProvider;
+    return S_OK;
+}
+HRESULT BubbleUiaRootProvider::GetPatternProvider(PATTERNID, IUnknown **provider) {
+    if (!provider) return E_INVALIDARG;
+    *provider = nullptr;
+    return currentHost() ? S_OK : UIA_E_ELEMENTNOTAVAILABLE;
+}
+HRESULT BubbleUiaRootProvider::GetPropertyValue(PROPERTYID property, VARIANT *value) {
+    if (!value) return E_INVALIDARG;
+    VariantInit(value);
+    if (!currentHost()) return UIA_E_ELEMENTNOTAVAILABLE;
+    if (property == UIA_NamePropertyId) {
+        value->vt = VT_BSTR;
+        value->bstrVal = SysAllocString(L"Petdex agent sessions");
+        if (!value->bstrVal) { value->vt = VT_EMPTY; return E_OUTOFMEMORY; }
+    } else if (property == UIA_ControlTypePropertyId) {
+        value->vt = VT_I4;
+        value->lVal = UIA_PaneControlTypeId;
+    } else if (property == UIA_IsEnabledPropertyId || property == UIA_IsControlElementPropertyId || property == UIA_IsContentElementPropertyId) {
+        value->vt = VT_BOOL;
+        value->boolVal = VARIANT_TRUE;
+    } else if (property == UIA_NativeWindowHandlePropertyId) {
+        value->vt = VT_I4;
+        value->lVal = static_cast<LONG>(reinterpret_cast<LONG_PTR>(owner_hwnd_));
+    }
+    return S_OK;
+}
+HRESULT BubbleUiaRootProvider::get_HostRawElementProvider(IRawElementProviderSimple **provider) {
+    if (!provider) return E_INVALIDARG;
+    if (!currentHost()) { *provider = nullptr; return UIA_E_ELEMENTNOTAVAILABLE; }
+    return UiaHostProviderFromHwnd(owner_hwnd_, provider);
+}
+HRESULT BubbleUiaRootProvider::Navigate(NavigateDirection direction, IRawElementProviderFragment **provider) {
+    if (!provider) return E_INVALIDARG;
+    *provider = nullptr;
+    Host *host = currentHost();
+    if (!host) return UIA_E_ELEMENTNOTAVAILABLE;
+    const auto children = bubbleUiaOrderedChildren(host, owner_window_id_);
+    if (children.empty()) return S_OK;
+    if (direction == NavigateDirection_FirstChild) return bubbleUiaChildProvider(children.front(), provider);
+    if (direction == NavigateDirection_LastChild) return bubbleUiaChildProvider(children.back(), provider);
+    return S_OK;
+}
+HRESULT BubbleUiaRootProvider::GetRuntimeId(SAFEARRAY **runtime_id) {
+    if (!runtime_id) return E_INVALIDARG;
+    *runtime_id = nullptr;
+    return currentHost() ? S_OK : UIA_E_ELEMENTNOTAVAILABLE;
+}
+HRESULT BubbleUiaRootProvider::get_BoundingRectangle(UiaRect *bounds) {
+    if (!bounds) return E_INVALIDARG;
+    Host *host = currentHost();
+    if (!host) return UIA_E_ELEMENTNOTAVAILABLE;
+    const auto children = bubbleUiaOrderedChildren(host, owner_window_id_);
+    RECT union_rect = {};
+    bool has_rect = false;
+    for (BubbleOverlay *child : children) {
+        RECT rect = {};
+        if (!GetWindowRect(child->hwnd, &rect)) continue;
+        if (!has_rect) { union_rect = rect; has_rect = true; }
+        else { union_rect.left = std::min(union_rect.left, rect.left); union_rect.top = std::min(union_rect.top, rect.top);
+            union_rect.right = std::max(union_rect.right, rect.right); union_rect.bottom = std::max(union_rect.bottom, rect.bottom); }
+    }
+    if (!has_rect && !GetWindowRect(owner_hwnd_, &union_rect)) return HRESULT_FROM_WIN32(GetLastError());
+    *bounds = { static_cast<double>(union_rect.left), static_cast<double>(union_rect.top),
+        static_cast<double>(union_rect.right - union_rect.left), static_cast<double>(union_rect.bottom - union_rect.top) };
+    return S_OK;
+}
+HRESULT BubbleUiaRootProvider::GetEmbeddedFragmentRoots(SAFEARRAY **roots) {
+    if (!roots) return E_INVALIDARG;
+    *roots = nullptr;
+    return currentHost() ? S_OK : UIA_E_ELEMENTNOTAVAILABLE;
+}
+HRESULT BubbleUiaRootProvider::SetFocus() { return currentHost() ? UIA_E_NOTSUPPORTED : UIA_E_ELEMENTNOTAVAILABLE; }
+HRESULT BubbleUiaRootProvider::get_FragmentRoot(IRawElementProviderFragmentRoot **root) {
+    if (!root) return E_INVALIDARG;
+    *root = nullptr;
+    if (!currentHost()) return UIA_E_ELEMENTNOTAVAILABLE;
+    *root = this;
+    AddRef();
+    return S_OK;
+}
+HRESULT BubbleUiaRootProvider::ElementProviderFromPoint(double x, double y, IRawElementProviderFragment **provider) {
+    if (!provider) return E_INVALIDARG;
+    *provider = nullptr;
+    Host *host = currentHost();
+    if (!host) return UIA_E_ELEMENTNOTAVAILABLE;
+    const auto children = bubbleUiaOrderedChildren(host, owner_window_id_);
+    for (auto iterator = children.rbegin(); iterator != children.rend(); ++iterator) {
+        RECT rect = {};
+        if (GetWindowRect((*iterator)->hwnd, &rect) && x >= rect.left && x < rect.right && y >= rect.top && y < rect.bottom)
+            return bubbleUiaChildProvider(*iterator, provider);
+    }
+    return S_OK;
+}
+HRESULT BubbleUiaRootProvider::GetFocus(IRawElementProviderFragment **provider) {
+    if (!provider) return E_INVALIDARG;
+    *provider = nullptr;
+    Host *host = currentHost();
+    if (!host) return UIA_E_ELEMENTNOTAVAILABLE;
+    /* These overlays are deliberately nonactivating and do not currently own
+     * keyboard/UIA focus. Pointer hover and press are presentation states, not
+     * focus; reporting either here makes assistive technology jump with the
+     * mouse. Keep the root focus empty until a genuine logical focus identity
+     * is introduced. */
+    return S_OK;
+}
+
+static BubbleOverlay *bubbleUiaCanonicalOverlay(BubbleOverlay *overlay) {
+    if (!overlay || overlay->kind != kBubbleControlOverlay || overlay->control.action != 0 || !overlay->host) return overlay;
+    for (auto &entry : overlay->host->bubble_overlays) {
+        BubbleOverlay *candidate = entry.second.get();
+        if (candidate && candidate->kind == kBubbleDisclosureOverlay && candidate->owner_window_id == overlay->owner_window_id)
+            return candidate;
+    }
+    return overlay;
+}
+
+static void forwardBubbleRightClick(BubbleOverlay &overlay, UINT message, WPARAM wparam) {
+    if (!overlay.host) return;
+    for (auto &entry : overlay.host->native_views) {
+        NativeView &view = entry.second;
+        if (view.window_id != overlay.owner_window_id || view.kind != kViewGpuSurface || !view.hwnd) continue;
+        POINT point = {};
+        GetCursorPos(&point);
+        ScreenToClient(view.hwnd, &point);
+        SendMessageW(view.hwnd, message, wparam, MAKELPARAM(point.x, point.y));
+        return;
+    }
+}
+
+static void moveBubbleDrag(BubbleOverlay &overlay, POINT cursor) {
+    Window *pet = bubbleWindowByLabel(overlay.host, "main");
+    const Window *owner = windowForId(overlay.host, overlay.owner_window_id);
+    if (!pet || !owner || !pet->hwnd || !owner->hwnd) return;
+    const int dx = cursor.x - overlay.press_screen.x;
+    const int dy = cursor.y - overlay.press_screen.y;
+    if (!overlay.dragging && std::abs(dx) + std::abs(dy) >= GetSystemMetrics(SM_CXDRAG)) {
+        overlay.dragging = true;
+        emitBubbleNativeCommand(overlay, "card", "drag-started");
+    }
+    if (!overlay.dragging) return;
+    SetWindowPos(pet->hwnd, nullptr, overlay.pet_start.left + dx, overlay.pet_start.top + dy, 0, 0,
+        SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE);
+    SetWindowPos(owner->hwnd, nullptr, overlay.owner_start.left + dx, overlay.owner_start.top + dy, 0, 0,
+        SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE);
+}
+
+static LRESULT CALLBACK bubbleOverlayProc(HWND hwnd, UINT message, WPARAM wparam, LPARAM lparam) {
+    if (message == WM_NCCREATE) {
+        auto *create = reinterpret_cast<CREATESTRUCTW *>(lparam);
+        SetWindowLongPtrW(hwnd, GWLP_USERDATA, reinterpret_cast<LONG_PTR>(create->lpCreateParams));
+    }
+    BubbleOverlay *overlay = bubbleOverlayFromHwnd(hwnd);
+    switch (message) {
+        case WM_GETOBJECT:
+            if (overlay && lparam == UiaRootObjectId) {
+                BubbleOverlay *canonical = bubbleUiaCanonicalOverlay(overlay);
+                auto *provider = new (std::nothrow) BubbleUiaProvider(canonical->hwnd);
+                if (!provider) return 0;
+                const LRESULT result = UiaReturnRawElementProvider(hwnd, wparam, lparam, provider);
+                provider->Release();
+                return result;
+            }
+            break;
+        case kBubbleUiaInvokeMessage:
+            if (overlay) {
+                if (overlay->kind == kBubbleCardOverlay && overlay->card.action_available)
+                    emitBubbleNativeCommand(*overlay, "card", "activate");
+                else if (overlay->kind == kBubbleDisclosureOverlay && overlay->disclosure.enabled)
+                    emitBubbleNativeCommand(*overlay, "control", "toggle");
+                else if (overlay->kind == kBubbleControlOverlay && overlay->control.enabled)
+                    emitBubbleControlCommand(*overlay);
+            }
+            return 0;
+        case WM_MOUSEACTIVATE: return MA_NOACTIVATE;
+        case WM_NCDESTROY:
+            SetWindowLongPtrW(hwnd, GWLP_USERDATA, 0);
+            break;
+        case WM_NCHITTEST: return HTCLIENT;
+        case WM_ERASEBKGND: return 1;
+        case WM_PAINT: {
+            PAINTSTRUCT paint = {};
+            BeginPaint(hwnd, &paint);
+            if (overlay) paintBubbleOverlay(*overlay);
+            EndPaint(hwnd, &paint);
+            return 0;
+        }
+        case WM_MOUSEMOVE:
+            if (overlay) {
