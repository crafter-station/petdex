+                const Window *owner = windowForId(overlay->host, overlay->owner_window_id);
+                if (pet && pet->hwnd) GetWindowRect(pet->hwnd, &overlay->pet_start);
+                if (owner && owner->hwnd) GetWindowRect(owner->hwnd, &overlay->owner_start);
+                SetCapture(hwnd);
+            }
+            return 0;
+        case WM_LBUTTONUP:
+            if (overlay && overlay->pressed) {
+                overlay->pressed = false;
+                ReleaseCapture();
+                if (overlay->dragging) {
+                    overlay->dragging = false;
+                    emitBubbleNativeCommand(*overlay, "card", "drag-ended");
+                } else if (overlay->kind == kBubbleCardOverlay) {
+                    if (overlay->card.action_available) emitBubbleNativeCommand(*overlay, "card", "activate");
+                } else if (overlay->kind == kBubbleControlOverlay) {
+                    emitBubbleControlCommand(*overlay);
+                }
+            }
+            return 0;
+        case WM_RBUTTONDOWN:
+        case WM_RBUTTONUP:
