+static HRESULT bubbleUiaChildProvider(BubbleOverlay *overlay, IRawElementProviderFragment **provider) {
+    if (!provider) return E_INVALIDARG;
+    *provider = nullptr;
+    if (!overlay || !overlay->hwnd) return S_OK;
+    auto *child = new (std::nothrow) BubbleUiaProvider(overlay->hwnd);
+    if (!child) return E_OUTOFMEMORY;
+    *provider = static_cast<IRawElementProviderFragment *>(child);
+    return S_OK;
+}
