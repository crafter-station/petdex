+    info.lpszText = const_cast<wchar_t *>(overlay.accessibility_name.c_str());
+    SendMessageW(overlay.tooltip, TTM_UPDATETIPTEXTW, 0, reinterpret_cast<LPARAM>(&info));
+}
+
+static void resizeBubbleRenderTarget(BubbleOverlay &overlay) {
+    if (!overlay.render_target || !overlay.hwnd) return;
+    RECT client = {};
+    GetClientRect(overlay.hwnd, &client);
+    overlay.render_target->Resize(D2D1::SizeU((UINT32)std::max<LONG>(1, client.right), (UINT32)std::max<LONG>(1, client.bottom)));
+    const FLOAT dpi = (FLOAT)dpiForWindow(overlay.hwnd);
+    overlay.render_target->SetDpi(dpi, dpi);
+}
+
+static bool applyBubbleWindowRegion(BubbleOverlay &overlay, int width, int height, UINT dpi) {
+    overlay.rounded_region_active = false;
+    if (!overlay.hwnd) return false;
+    width = std::max(1, width);
+    height = std::max(1, height);
+    const double scale = (double)(dpi ? dpi : dpiForWindow(overlay.hwnd)) / 96.0;
+    const float logical_radius = overlay.kind == kBubbleCardOverlay ? overlay.card.glass.radius :
+        overlay.kind == kBubbleDisclosureOverlay ? overlay.disclosure.glass.radius :
+        std::min(overlay.control.frame.w, overlay.control.frame.h) * 0.5f;
+    const int diameter = std::max(1, nativeViewCoord(logical_radius * 2 * scale));
+    HRGN region = CreateRoundRectRgn(0, 0, width + 1, height + 1, diameter, diameter);
+    if (!region) {
+        SetWindowRgn(overlay.hwnd, nullptr, TRUE);
+        return false;
+    }
+    if (SetWindowRgn(overlay.hwnd, region, TRUE) == 0) {
+        DeleteObject(region);
+        SetWindowRgn(overlay.hwnd, nullptr, TRUE);
+        return false;
+    }
+    overlay.rounded_region_active = true;
+    return true;
+}
+
+static void placeBubbleOverlay(BubbleOverlay &overlay) {
+    const Window *owner = windowForId(overlay.host, overlay.owner_window_id);
+    if (!owner || !owner->hwnd || !overlay.hwnd) return;
+    POINT origin = { 0, 0 };
+    ClientToScreen(owner->hwnd, &origin);
+    const double scale = (double)dpiForWindow(owner->hwnd) / 96.0;
+    const int left = origin.x + nativeViewCoord(overlay.frame.x * scale);
+    const int top = origin.y + nativeViewCoord(overlay.frame.y * scale);
+    const int right = origin.x + nativeViewCoord((overlay.frame.x + overlay.frame.w) * scale);
+    const int bottom = origin.y + nativeViewCoord((overlay.frame.y + overlay.frame.h) * scale);
+    const int width = std::max(1, right - left);
+    const int height = std::max(1, bottom - top);
+    const bool was_visible = IsWindowVisible(overlay.hwnd) != FALSE;
+    /* SetWindowRgn owns the supplied region and applies it synchronously. Put
+     * the destination-sized region on the HWND before resizing a visible
+     * overlay, so DWM can never compose the new bounds with the stale region. */
+    applyBubbleWindowRegion(overlay, width, height, dpiForWindow(owner->hwnd));
+    applyBubbleBackdrop(overlay);
+    SetWindowPos(overlay.hwnd, owner->floating ? HWND_TOPMOST : HWND_TOP, left, top, width, height,
+        SWP_NOACTIVATE | SWP_NOOWNERZORDER);
+    /* Establish the render target and first paint before the compositor sees
+     * SWP_SHOWWINDOW, so a newly-created card never presents square. */
+    resizeBubbleRenderTarget(overlay);
+    InvalidateRect(overlay.hwnd, nullptr, FALSE);
+    RedrawWindow(overlay.hwnd, nullptr, nullptr, RDW_INVALIDATE | RDW_UPDATENOW);
+    if (!was_visible) {
+        SetWindowPos(overlay.hwnd, nullptr, 0, 0, 0, 0,
+            SWP_NOACTIVATE | SWP_SHOWWINDOW | SWP_NOMOVE | SWP_NOSIZE | SWP_NOZORDER);
+    }
+}
+
+static void placeBubbleOverlaysForWindow(Host *host, uint64_t window_id) {
+    if (!host) return;
+    for (auto &entry : host->bubble_overlays) {
+        if (entry.second->owner_window_id == window_id) placeBubbleOverlay(*entry.second);
+    }
+}
+
+static void emitBubbleNativeCommand(BubbleOverlay &overlay, const char *kind, const char *action) {
+    if (!overlay.host || !overlay.host->callback) return;
+    char command[128] = {};
+    snprintf(command, sizeof(command), "petdex.bubble.%s.%s.%016llx", kind, action, (unsigned long long)overlay.identity);
+    const char *label = overlay.kind == kBubbleCardOverlay ? "bubble-card" : "bubble-control";
+    WindowsEvent event = {};
+    event.kind = kNativeCommand;
+    event.window_id = overlay.owner_window_id;
+    event.command_name = command;
+    event.command_name_len = strlen(command);
+    event.view_label = label;
+    event.view_label_len = strlen(label);
+    overlay.host->callback(overlay.host->callback_context, &event);
+}
+
+static void emitBubbleControlCommand(BubbleOverlay &overlay) {
+    if (!overlay.control.enabled) return;
+    const char *actions[] = { "toggle", "open", "pin", "subagents", "dismiss" };
+    const int action = overlay.control.action;
+    if (action < 0 || action >= (int)(sizeof(actions) / sizeof(actions[0]))) return;
+    emitBubbleNativeCommand(overlay, "control", actions[action]);
+}
+
+constexpr UINT kBubbleUiaInvokeMessage = WM_APP + 0x51;
+
+static constexpr int bubbleUiaKindRank(BubbleOverlayKind kind) {
+    return kind == kBubbleCardOverlay ? 0 : kind == kBubbleDisclosureOverlay ? 1 : 2;
+}
+static_assert(bubbleUiaKindRank(kBubbleCardOverlay) < bubbleUiaKindRank(kBubbleDisclosureOverlay));
+static_assert(bubbleUiaKindRank(kBubbleDisclosureOverlay) < bubbleUiaKindRank(kBubbleControlOverlay));
+
+static bool bubbleUiaIncluded(const BubbleOverlay &overlay) {
+    return overlay.hwnd && IsWindowVisible(overlay.hwnd) &&
+        !(overlay.kind == kBubbleControlOverlay && overlay.control.action == 0);
+}
+
+static std::vector<BubbleOverlay *> bubbleUiaOrderedChildren(Host *host, uint64_t owner_window_id) {
+    std::vector<BubbleOverlay *> children;
+    if (!host) return children;
+    for (auto &entry : host->bubble_overlays) {
+        BubbleOverlay *overlay = entry.second.get();
+        if (overlay && overlay->owner_window_id == owner_window_id && bubbleUiaIncluded(*overlay)) children.push_back(overlay);
+    }
+    std::stable_sort(children.begin(), children.end(), [](const BubbleOverlay *left, const BubbleOverlay *right) {
+        const int left_rank = bubbleUiaKindRank(left->kind);
+        const int right_rank = bubbleUiaKindRank(right->kind);
+        if (left_rank != right_rank) return left_rank < right_rank;
+        if (left->frame.y != right->frame.y) return left->frame.y < right->frame.y;
+        if (left->frame.x != right->frame.x) return left->frame.x < right->frame.x;
+        if (left->identity != right->identity) return left->identity < right->identity;
+        return left->action < right->action;
+    });
+    return children;
+}
+
+class BubbleUiaProvider;
