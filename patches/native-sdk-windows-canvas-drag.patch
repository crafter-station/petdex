+static void applyBubbleAccessibilityName(BubbleOverlay &overlay, const std::wstring &name) {
+    overlay.accessibility_name = name;
+    if (!overlay.hwnd) return;
+    const std::string *value_utf8 = nullptr;
+    int semantic_role = 1;
+    bool enabled = true;
+    bool toggled = false;
+    bool action_available = true;
+    if (overlay.kind == kBubbleCardOverlay) {
+        value_utf8 = &overlay.card.accessibility_value;
+        semantic_role = overlay.card.accessibility_role;
+        action_available = overlay.card.action_available;
+    } else if (overlay.kind == kBubbleControlOverlay) {
+        value_utf8 = &overlay.control.accessibility_value;
+        semantic_role = overlay.control.accessibility_role;
+        enabled = overlay.control.enabled;
+        toggled = overlay.control.toggled;
+    } else {
+        value_utf8 = &overlay.disclosure.accessibility_value;
+        semantic_role = overlay.disclosure.accessibility_role;
+        enabled = overlay.disclosure.enabled;
+        toggled = overlay.disclosure.toggled;
+    }
+    IAccPropServices *services = nullptr;
+    if (SUCCEEDED(CoCreateInstance(CLSID_AccPropServices, nullptr, CLSCTX_SERVER, IID_IAccPropServices, reinterpret_cast<void **>(&services))) && services) {
+        services->SetHwndPropStr(overlay.hwnd, OBJID_CLIENT, CHILDID_SELF, PROPID_ACC_NAME, name.c_str());
+        const std::wstring value = value_utf8 ? widen(*value_utf8) : std::wstring();
+        services->SetHwndPropStr(overlay.hwnd, OBJID_CLIENT, CHILDID_SELF, PROPID_ACC_VALUE, value.c_str());
+        services->SetHwndPropStr(overlay.hwnd, OBJID_CLIENT, CHILDID_SELF, PROPID_ACC_DESCRIPTION,
+            overlay.kind == kBubbleCardOverlay ? L"Agent session. Press to open; drag to move Petdex." : L"Petdex session action");
+        services->SetHwndPropStr(overlay.hwnd, OBJID_CLIENT, CHILDID_SELF, PROPID_ACC_DEFAULTACTION, action_available && enabled ? L"Press" : L"");
+        VARIANT role;
+        VariantInit(&role);
+        role.vt = VT_I4;
+        role.lVal = semantic_role == 0 ? ROLE_SYSTEM_GROUPING : semantic_role == 2 ? ROLE_SYSTEM_CHECKBUTTON : ROLE_SYSTEM_PUSHBUTTON;
+        services->SetHwndProp(overlay.hwnd, OBJID_CLIENT, CHILDID_SELF, PROPID_ACC_ROLE, role);
+        VariantClear(&role);
+        VARIANT state;
+        VariantInit(&state);
+        state.vt = VT_I4;
+        state.lVal = (!enabled || !action_available ? STATE_SYSTEM_UNAVAILABLE : 0) | (toggled ? STATE_SYSTEM_CHECKED : 0);
+        services->SetHwndProp(overlay.hwnd, OBJID_CLIENT, CHILDID_SELF, PROPID_ACC_STATE, state);
+        VariantClear(&state);
+        services->Release();
+    }
+    SetWindowTextW(overlay.hwnd, name.c_str());
+}
