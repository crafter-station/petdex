+static void destroyBubbleOverlaysForWindow(Host *host, uint64_t window_id) {
+    if (!host) return;
+    for (auto it = host->bubble_overlays.begin(); it != host->bubble_overlays.end();) {
+        BubbleOverlay &overlay = *it->second;
+        if (overlay.owner_window_id != window_id) { ++it; continue; }
+        if (overlay.hwnd) DestroyWindow(overlay.hwnd);
+        it = host->bubble_overlays.erase(it);
+    }
+    host->bubble_presentation_digest = 0;
+}
+
+static bool applyPetdexBubblePresentation(Host *host, uint64_t window_id, const char *bytes, size_t length) {
+    if (!host || !bytes || length == 0 || length > kMaxBubblePresentationBytes) return false;
+    BubbleJsonValue root;
+    BubbleJsonParser parser(bytes, length);
+    if (!parser.parse(&root) || root.kind != BubbleJsonValue::kObject) return false;
+    if (bubbleJsonInteger(root, "version") != 1) return false;
+    const uint64_t digest = bubbleJsonInteger(root, "digest");
+    if (digest != 0 && digest == host->bubble_presentation_digest) return true;
+    const Window *owner = windowForId(host, window_id);
+    if (!owner || !owner->hwnd) return false;
+
+    std::map<std::string, bool> live;
+    const BubbleJsonValue *cards = bubbleJsonMember(root, "cards");
+    if (cards && cards->kind == BubbleJsonValue::kArray) {
+        size_t count = 0;
+        for (const BubbleJsonValue &item : cards->array) {
+            if (count++ >= 8 || item.kind != BubbleJsonValue::kObject) break;
+            BubbleCardPresentation card;
+            if (!bubbleJsonCard(item, &card)) continue;
+            char key_bytes[64] = {};
+            snprintf(key_bytes, sizeof(key_bytes), "card:%016llx", (unsigned long long)card.glass.identity);
+            const std::string key(key_bytes);
+            BubbleOverlay *overlay = createBubbleOverlay(host, window_id, key, kBubbleCardOverlay);
+            if (!overlay) continue;
+            overlay->identity = card.glass.identity;
+            overlay->card = std::move(card);
+            overlay->frame = overlay->card.glass.frame;
+            applyBubbleAccessibilityName(*overlay, widen(overlay->card.accessibility_label));
+            applyBubbleBackdrop(*overlay);
+            if (overlay->card.busy && !overlay->card.reduce_motion &&
+                overlay->card.glass.materialization != 0 && overlay->card.glass.alpha > 0.001f)
+                SetTimer(overlay->hwnd, kBubbleShimmerTimerId, 33, nullptr);
+            else KillTimer(overlay->hwnd, kBubbleShimmerTimerId);
+            if (overlay->card.glass.materialization == 0 || overlay->card.glass.alpha <= 0.001f) ShowWindow(overlay->hwnd, SW_HIDE);
+            else placeBubbleOverlay(*overlay);
+            live[key] = true;
+        }
+    }
+
+    const BubbleJsonValue *disclosure = bubbleJsonMember(root, "disclosure");
+    if (disclosure && disclosure->kind == BubbleJsonValue::kObject && bubbleJsonBool(*disclosure, "visible")) {
+        const BubbleJsonValue *glass = bubbleJsonMember(*disclosure, "glass");
+        if (glass && glass->kind == BubbleJsonValue::kObject) {
+            BubbleOverlay *overlay = createBubbleOverlay(host, window_id, "disclosure", kBubbleDisclosureOverlay);
+            if (overlay) {
+                overlay->disclosure.glass = bubbleJsonGlass(*glass);
+                overlay->disclosure.visible = true;
+                overlay->disclosure.mode = (int)bubbleJsonInteger(*disclosure, "mode");
+                overlay->disclosure.state = (int)bubbleJsonInteger(*disclosure, "state");
+                overlay->disclosure.session_count = (int)bubbleJsonInteger(*disclosure, "session_count");
+                overlay->disclosure.show_status_icon = bubbleJsonBool(*disclosure, "show_status_icon");
+                overlay->disclosure.alpha = (float)bubbleJsonNumber(*disclosure, "alpha", 1);
+                overlay->disclosure.accessibility_label = bubbleJsonString(*disclosure, "accessibility_label");
+                overlay->disclosure.accessibility_value = bubbleJsonString(*disclosure, "accessibility_value");
+                overlay->disclosure.accessibility_role = (int)bubbleJsonInteger(*disclosure, "accessibility_role");
+                overlay->disclosure.enabled = bubbleJsonBool(*disclosure, "enabled");
+                overlay->disclosure.toggled = bubbleJsonBool(*disclosure, "toggled");
+                overlay->identity = overlay->disclosure.glass.identity;
+                overlay->frame = overlay->disclosure.glass.frame;
+                applyBubbleAccessibilityName(*overlay, widen(overlay->disclosure.accessibility_label));
+                applyBubbleBackdrop(*overlay);
+                placeBubbleOverlay(*overlay);
+                live["disclosure"] = true;
+            }
+        }
+    }
+
+    const BubbleJsonValue *controls = bubbleJsonMember(root, "controls");
+    if (controls && controls->kind == BubbleJsonValue::kArray) {
+        size_t count = 0;
+        for (const BubbleJsonValue &item : controls->array) {
+            if (count++ >= 40 || item.kind != BubbleJsonValue::kObject) break;
+            BubbleControlPresentation control;
+            control.identity = bubbleJsonInteger(item, "id");
+            control.action = (int)bubbleJsonInteger(item, "action");
+            control.frame = bubbleJsonFrame(item);
+            control.selected = bubbleJsonBool(item, "selected");
+            control.badge_count = (int)bubbleJsonInteger(item, "badge_count");
+            control.alpha = (float)bubbleJsonNumber(item, "alpha", 1);
+            control.activation_inset = (float)bubbleJsonNumber(item, "activation_inset");
+            control.overlay = bubbleJsonBool(item, "overlay");
+            control.points_up = bubbleJsonBool(item, "points_up");
+            control.mode = (int)bubbleJsonInteger(item, "mode");
+            control.state = (int)bubbleJsonInteger(item, "state");
+            control.show_status_icon = bubbleJsonBool(item, "show_status_icon");
+            control.accessibility_label = bubbleJsonString(item, "accessibility_label");
+            control.accessibility_value = bubbleJsonString(item, "accessibility_value");
+            control.accessibility_role = (int)bubbleJsonInteger(item, "accessibility_role");
+            control.enabled = bubbleJsonBool(item, "enabled");
+            control.toggled = bubbleJsonBool(item, "toggled");
+            if (control.identity == 0 || control.action < 0 || control.action > 4 || control.frame.w <= 0 || control.frame.h <= 0) continue;
+            char key_bytes[80] = {};
+            snprintf(key_bytes, sizeof(key_bytes), "control:%016llx:%d", (unsigned long long)control.identity, control.action);
+            const std::string key(key_bytes);
+            BubbleOverlay *overlay = createBubbleOverlay(host, window_id, key, kBubbleControlOverlay);
+            if (!overlay) continue;
+            overlay->identity = control.identity;
+            overlay->action = control.action;
+            overlay->control = control;
+            overlay->frame = control.frame;
+            applyBubbleAccessibilityName(*overlay, widen(control.accessibility_label));
+            ensureBubbleTooltip(*overlay);
+            updateBubbleTooltip(*overlay);
+            applyBubbleBackdrop(*overlay);
+            if (control.alpha <= 0.001f) ShowWindow(overlay->hwnd, SW_HIDE);
+            else placeBubbleOverlay(*overlay);
+            live[key] = true;
+        }
+    }
+
+    for (auto it = host->bubble_overlays.begin(); it != host->bubble_overlays.end();) {
+        if (it->second->owner_window_id != window_id || live.find(it->first) != live.end()) { ++it; continue; }
+        if (it->second->hwnd) DestroyWindow(it->second->hwnd);
+        it = host->bubble_overlays.erase(it);
+    }
+    host->bubble_presentation_digest = digest;
+    host->bubble_presentation_generation = bubbleJsonInteger(root, "placement_generation");
+    if (host->bubble_dcomp_device) host->bubble_dcomp_device->Commit();
+    return true;
+}
