+static void ensureBubbleTooltip(BubbleOverlay &overlay) {
+    if (!overlay.hwnd || overlay.tooltip || overlay.kind != kBubbleControlOverlay) return;
+    overlay.tooltip = CreateWindowExW(WS_EX_TOPMOST | WS_EX_NOACTIVATE, TOOLTIPS_CLASSW, nullptr,
+        WS_POPUP | TTS_ALWAYSTIP | TTS_NOPREFIX, CW_USEDEFAULT, CW_USEDEFAULT, CW_USEDEFAULT, CW_USEDEFAULT,
+        overlay.hwnd, nullptr, overlay.host->instance, nullptr);
+    if (!overlay.tooltip) return;
+    TOOLINFOW info = {};
+    info.cbSize = sizeof(info);
+    info.uFlags = TTF_IDISHWND | TTF_SUBCLASS;
+    info.hwnd = overlay.hwnd;
+    info.uId = reinterpret_cast<UINT_PTR>(overlay.hwnd);
+    info.lpszText = const_cast<wchar_t *>(overlay.accessibility_name.c_str());
+    SendMessageW(overlay.tooltip, TTM_ADDTOOLW, 0, reinterpret_cast<LPARAM>(&info));
+    SendMessageW(overlay.tooltip, TTM_SETMAXTIPWIDTH, 0, 320);
+}
+
+static void updateBubbleTooltip(BubbleOverlay &overlay) {
+    if (!overlay.tooltip || !overlay.hwnd) return;
+    TOOLINFOW info = {};
+    info.cbSize = sizeof(info);
+    info.uFlags = TTF_IDISHWND | TTF_SUBCLASS;
+    info.hwnd = overlay.hwnd;
