+static bool ensureBubbleGraphics(Host *host) {
+    if (!host) return false;
+    if (!host->bubble_d2d_factory) {
+        if (FAILED(D2D1CreateFactory(D2D1_FACTORY_TYPE_SINGLE_THREADED, &host->bubble_d2d_factory))) return false;
+    }
+    if (!host->bubble_dwrite_factory) {
+        if (FAILED(DWriteCreateFactory(DWRITE_FACTORY_TYPE_SHARED, __uuidof(IDWriteFactory), reinterpret_cast<IUnknown **>(&host->bubble_dwrite_factory)))) return false;
+    }
+    /* DirectComposition is optional at runtime. D2D/DWrite remain the
+     * semantic fallback if policy, remote desktop, or an older compositor
+     * rejects it. A null rendering device requests the in-box compositor's
+     * default device and avoids adding a D3D dependency to the app. */
+    if (!host->bubble_dcomp_device) {
+        (void)DCompositionCreateDevice(nullptr, __uuidof(IDCompositionDevice), reinterpret_cast<void **>(&host->bubble_dcomp_device));
+    }
+    return true;
+}
