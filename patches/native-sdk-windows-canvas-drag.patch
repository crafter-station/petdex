+class BubbleUiaProvider final : public IRawElementProviderSimple, public IRawElementProviderFragment, public IInvokeProvider, public IToggleProvider {
+public:
+    explicit BubbleUiaProvider(HWND hwnd) : refs_(1), hwnd_(hwnd) {
+        BubbleOverlay *overlay = bubbleOverlayFromHwnd(hwnd);
+        if (overlay) { identity_ = overlay->identity; kind_ = overlay->kind; action_ = overlay->action; }
+    }
+
+    HRESULT STDMETHODCALLTYPE QueryInterface(REFIID iid, void **out) override {
+        if (!out) return E_INVALIDARG;
+        *out = nullptr;
+        if (iid == IID_IUnknown || iid == IID_IRawElementProviderSimple) *out = static_cast<IRawElementProviderSimple *>(this);
+        else if (iid == IID_IRawElementProviderFragment) *out = static_cast<IRawElementProviderFragment *>(this);
+        else if (iid == IID_IInvokeProvider) {
+            BubbleOverlay *overlay = currentOverlay();
+            if (!overlay || (overlay->kind == kBubbleCardOverlay && !overlay->card.action_available)) return E_NOINTERFACE;
+            *out = static_cast<IInvokeProvider *>(this);
+        }
+        else if (iid == IID_IToggleProvider) {
+            BubbleOverlay *overlay = currentOverlay();
+            if (!overlay || (overlay->kind != kBubbleDisclosureOverlay &&
+                (overlay->kind != kBubbleControlOverlay || overlay->control.accessibility_role != 2))) return E_NOINTERFACE;
+            *out = static_cast<IToggleProvider *>(this);
+        }
+        else return E_NOINTERFACE;
+        AddRef();
+        return S_OK;
+    }
+    ULONG STDMETHODCALLTYPE AddRef() override { return ++refs_; }
+    ULONG STDMETHODCALLTYPE Release() override {
+        const ULONG remaining = --refs_;
+        if (!remaining) delete this;
+        return remaining;
+    }
+    HRESULT STDMETHODCALLTYPE get_ProviderOptions(ProviderOptions *options) override {
+        if (!options) return E_INVALIDARG;
+        *options = ProviderOptions_ServerSideProvider;
+        return S_OK;
+    }
+    HRESULT STDMETHODCALLTYPE GetPatternProvider(PATTERNID pattern, IUnknown **provider) override {
+        if (!provider) return E_INVALIDARG;
+        *provider = nullptr;
+        BubbleOverlay *overlay = currentOverlay();
+        if (!overlay) return UIA_E_ELEMENTNOTAVAILABLE;
+        if (pattern == UIA_InvokePatternId && (overlay->kind == kBubbleDisclosureOverlay || overlay->kind == kBubbleControlOverlay || (overlay->kind == kBubbleCardOverlay && overlay->card.action_available)))
+            return QueryInterface(IID_IInvokeProvider, reinterpret_cast<void **>(provider));
+        if (pattern == UIA_TogglePatternId && (overlay->kind == kBubbleDisclosureOverlay || (overlay->kind == kBubbleControlOverlay && overlay->control.accessibility_role == 2)))
+            return QueryInterface(IID_IToggleProvider, reinterpret_cast<void **>(provider));
+        return S_OK;
+    }
+    HRESULT STDMETHODCALLTYPE GetPropertyValue(PROPERTYID property, VARIANT *value) override {
+        if (!value) return E_INVALIDARG;
+        VariantInit(value);
+        BubbleOverlay *overlay = currentOverlay();
+        if (!overlay) return UIA_E_ELEMENTNOTAVAILABLE;
+        if (property == UIA_NamePropertyId) {
+            value->vt = VT_BSTR;
+            value->bstrVal = SysAllocString(overlay->accessibility_name.c_str());
+            if (!value->bstrVal) { value->vt = VT_EMPTY; return E_OUTOFMEMORY; }
+        } else if (property == UIA_ControlTypePropertyId) {
+            value->vt = VT_I4;
+            value->lVal = overlay->kind == kBubbleCardOverlay && !overlay->card.action_available ? UIA_GroupControlTypeId :
+                overlay->kind == kBubbleDisclosureOverlay || (overlay->kind == kBubbleControlOverlay && overlay->control.accessibility_role == 2) ? UIA_CheckBoxControlTypeId : UIA_ButtonControlTypeId;
+        } else if (property == UIA_IsEnabledPropertyId) {
+            const bool enabled = overlay->kind == kBubbleCardOverlay ? overlay->card.action_available :
+                overlay->kind == kBubbleDisclosureOverlay ? overlay->disclosure.enabled : overlay->control.enabled;
+            value->vt = VT_BOOL;
+            value->boolVal = enabled ? VARIANT_TRUE : VARIANT_FALSE;
+        } else if (property == UIA_IsKeyboardFocusablePropertyId) {
+            value->vt = VT_BOOL;
+            value->boolVal = VARIANT_FALSE;
+        } else if (property == UIA_NativeWindowHandlePropertyId) {
+            value->vt = VT_I4;
+            value->lVal = (LONG)(LONG_PTR)hwnd_;
+        } else if (property == UIA_HelpTextPropertyId) {
+            const std::string &help = overlay->kind == kBubbleCardOverlay ? overlay->card.accessibility_value :
+                overlay->kind == kBubbleDisclosureOverlay ? overlay->disclosure.accessibility_value : overlay->control.accessibility_value;
+            value->vt = VT_BSTR;
+            value->bstrVal = SysAllocString(widen(help).c_str());
+            if (!value->bstrVal) { value->vt = VT_EMPTY; return E_OUTOFMEMORY; }
+        } else if (property == UIA_ToggleToggleStatePropertyId) {
+            const bool toggled = overlay->kind == kBubbleDisclosureOverlay ? overlay->disclosure.toggled : overlay->control.toggled;
+            value->vt = VT_I4;
+            value->lVal = toggled ? ToggleState_On : ToggleState_Off;
+        } else if (property == UIA_SelectionItemIsSelectedPropertyId) {
+            value->vt = VT_BOOL;
+            value->boolVal = overlay->kind == kBubbleControlOverlay && overlay->control.selected ? VARIANT_TRUE : VARIANT_FALSE;
+        }
+        return S_OK;
+    }
+    HRESULT STDMETHODCALLTYPE get_HostRawElementProvider(IRawElementProviderSimple **provider) override {
+        if (!provider) return E_INVALIDARG;
+        *provider = nullptr;
+        return currentOverlay() ? S_OK : UIA_E_ELEMENTNOTAVAILABLE;
+    }
+    HRESULT STDMETHODCALLTYPE Invoke() override {
+        BubbleOverlay *overlay = currentOverlay();
+        if (!overlay) return UIA_E_ELEMENTNOTAVAILABLE;
+        if ((overlay->kind == kBubbleCardOverlay && !overlay->card.action_available) ||
+            (overlay->kind == kBubbleDisclosureOverlay && !overlay->disclosure.enabled) ||
+            (overlay->kind == kBubbleControlOverlay && !overlay->control.enabled)) return UIA_E_ELEMENTNOTENABLED;
+        PostMessageW(hwnd_, kBubbleUiaInvokeMessage, 0, 0);
+        return S_OK;
+    }
+    HRESULT STDMETHODCALLTYPE Toggle() override { return Invoke(); }
+    HRESULT STDMETHODCALLTYPE get_ToggleState(ToggleState *state) override {
+        if (!state) return E_INVALIDARG;
+        BubbleOverlay *overlay = currentOverlay();
+        if (!overlay) return UIA_E_ELEMENTNOTAVAILABLE;
+        if (overlay->kind != kBubbleDisclosureOverlay && (overlay->kind != kBubbleControlOverlay || overlay->control.accessibility_role != 2)) return E_NOINTERFACE;
+        const bool toggled = overlay->kind == kBubbleDisclosureOverlay ? overlay->disclosure.toggled : overlay->control.toggled;
+        *state = toggled ? ToggleState_On : ToggleState_Off;
+        return S_OK;
+    }
+    HRESULT STDMETHODCALLTYPE Navigate(NavigateDirection direction, IRawElementProviderFragment **provider) override {
+        if (!provider) return E_INVALIDARG;
+        *provider = nullptr;
+        BubbleOverlay *overlay = currentOverlay();
+        if (!overlay) return UIA_E_ELEMENTNOTAVAILABLE;
+        if (direction == NavigateDirection_Parent) {
+            const Window *owner = windowForId(overlay->host, overlay->owner_window_id);
+            if (!owner || !owner->hwnd) return UIA_E_ELEMENTNOTAVAILABLE;
+            auto *root = new (std::nothrow) BubbleUiaRootProvider(overlay->host, overlay->owner_window_id, owner->hwnd);
+            if (!root) return E_OUTOFMEMORY;
+            const HRESULT result = root->QueryInterface(IID_IRawElementProviderFragment, reinterpret_cast<void **>(provider));
+            root->Release();
+            return result;
+        }
+        if (direction != NavigateDirection_NextSibling && direction != NavigateDirection_PreviousSibling) return S_OK;
+        const auto children = bubbleUiaOrderedChildren(overlay->host, overlay->owner_window_id);
+        for (size_t index = 0; index < children.size(); ++index) {
+            if (children[index]->hwnd != hwnd_) continue;
+            const size_t sibling_index = direction == NavigateDirection_NextSibling ? index + 1 : (index == 0 ? children.size() : index - 1);
+            if (sibling_index >= children.size()) return S_OK;
+            auto *sibling = new (std::nothrow) BubbleUiaProvider(children[sibling_index]->hwnd);
+            if (!sibling) return E_OUTOFMEMORY;
+            *provider = static_cast<IRawElementProviderFragment *>(sibling);
+            return S_OK;
+        }
+        return UIA_E_ELEMENTNOTAVAILABLE;
+    }
+    HRESULT STDMETHODCALLTYPE GetRuntimeId(SAFEARRAY **runtime_id) override {
+        if (!runtime_id) return E_INVALIDARG;
+        *runtime_id = nullptr;
+        BubbleOverlay *overlay = currentOverlay();
+        if (!overlay) return UIA_E_ELEMENTNOTAVAILABLE;
+        SAFEARRAY *ids = SafeArrayCreateVector(VT_I4, 0, 5);
+        if (!ids) return E_OUTOFMEMORY;
+        LONG *values = nullptr;
+        if (FAILED(SafeArrayAccessData(ids, reinterpret_cast<void **>(&values)))) { SafeArrayDestroy(ids); return E_FAIL; }
+        values[0] = UiaAppendRuntimeId;
+        values[1] = bubbleUiaKindRank(overlay->kind);
+        values[2] = static_cast<LONG>(overlay->identity & 0xffffffffu);
+        values[3] = static_cast<LONG>((overlay->identity >> 32) & 0xffffffffu);
+        values[4] = overlay->action;
+        SafeArrayUnaccessData(ids);
+        *runtime_id = ids;
+        return S_OK;
+    }
+    HRESULT STDMETHODCALLTYPE get_BoundingRectangle(UiaRect *bounds) override {
+        if (!bounds) return E_INVALIDARG;
+        BubbleOverlay *overlay = currentOverlay();
+        if (!overlay) return UIA_E_ELEMENTNOTAVAILABLE;
+        RECT rect = {};
+        if (!GetWindowRect(hwnd_, &rect)) return HRESULT_FROM_WIN32(GetLastError());
+        *bounds = { static_cast<double>(rect.left), static_cast<double>(rect.top),
+            static_cast<double>(rect.right - rect.left), static_cast<double>(rect.bottom - rect.top) };
+        return S_OK;
+    }
+    HRESULT STDMETHODCALLTYPE GetEmbeddedFragmentRoots(SAFEARRAY **roots) override {
+        if (!roots) return E_INVALIDARG;
+        *roots = nullptr;
+        return currentOverlay() ? S_OK : UIA_E_ELEMENTNOTAVAILABLE;
+    }
+    HRESULT STDMETHODCALLTYPE SetFocus() override { return currentOverlay() ? UIA_E_NOTSUPPORTED : UIA_E_ELEMENTNOTAVAILABLE; }
+    HRESULT STDMETHODCALLTYPE get_FragmentRoot(IRawElementProviderFragmentRoot **root) override {
+        if (!root) return E_INVALIDARG;
+        *root = nullptr;
+        BubbleOverlay *overlay = currentOverlay();
+        if (!overlay) return UIA_E_ELEMENTNOTAVAILABLE;
+        const Window *owner = windowForId(overlay->host, overlay->owner_window_id);
+        if (!owner || !owner->hwnd) return UIA_E_ELEMENTNOTAVAILABLE;
+        auto *result = new (std::nothrow) BubbleUiaRootProvider(overlay->host, overlay->owner_window_id, owner->hwnd);
+        if (!result) return E_OUTOFMEMORY;
+        *root = static_cast<IRawElementProviderFragmentRoot *>(result);
+        return S_OK;
+    }
+
+private:
+    BubbleOverlay *currentOverlay() const {
+        if (!IsWindow(hwnd_)) return nullptr;
+        BubbleOverlay *overlay = bubbleOverlayFromHwnd(hwnd_);
+        return overlay && overlay->identity == identity_ && overlay->kind == kind_ &&
+            (kind_ != kBubbleControlOverlay || overlay->action == action_) ? overlay : nullptr;
+    }
+    std::atomic<ULONG> refs_;
+    HWND hwnd_;
+    uint64_t identity_ = 0;
+    BubbleOverlayKind kind_ = kBubbleCardOverlay;
+    int action_ = 0;
+};
