+static void recordWindowMoveSample(Window &window) {
+    if (!window.hwnd) return;
+    RECT rect = {};
+    if (!GetWindowRect(window.hwnd, &rect)) return;
+    const double scale = (double)dpiForWindow(window.hwnd) / 96.0;
+    window.x = (double)rect.left / scale;
+    window.y = (double)rect.top / scale;
+    const ULONGLONG now = GetTickCount64();
+    if (!window.move_samples.empty()) {
+        const WindowMoveSample &last = window.move_samples.back();
+        if (last.scale != scale) window.move_samples.clear();
+    }
+    if (!window.move_samples.empty()) {
+        const WindowMoveSample &last = window.move_samples.back();
+        if (last.x == window.x && last.y == window.y && now == last.at_ms) return;
+    }
+    window.move_samples.push_back({ window.x, window.y, scale, now });
+    while (window.move_samples.size() > 2 && now - window.move_samples.front().at_ms > 100) {
+        window.move_samples.erase(window.move_samples.begin());
+    }
+    if (window.move_samples.size() > 16) {
+        window.move_samples.erase(window.move_samples.begin(), window.move_samples.end() - 16);
+    }
+}
+
+static void recentWindowVelocity(const Window &window, double *vx, double *vy) {
+    *vx = 0;
+    *vy = 0;
+    if (window.move_samples.size() < 2) return;
+    const WindowMoveSample &first = window.move_samples.front();
+    const WindowMoveSample &last = window.move_samples.back();
+    const ULONGLONG elapsed = last.at_ms - first.at_ms;
+    if (elapsed == 0) return;
+    *vx = (last.x - first.x) * 1000.0 / (double)elapsed;
+    *vy = (last.y - first.y) * 1000.0 / (double)elapsed;
+}
