+static bool bubbleAcrylicEligible(const BubbleOverlay &overlay) {
+    if (overlay.card.glass.high_contrast || overlay.disclosure.glass.high_contrast || bubbleSystemHighContrast()) return false;
+    BOOL composition = FALSE;
+    if (FAILED(DwmIsCompositionEnabled(&composition)) || !composition) return false;
+    if (GetSystemMetrics(SM_REMOTESESSION)) return false;
