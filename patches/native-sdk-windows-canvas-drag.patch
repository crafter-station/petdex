+/* Small, bounded JSON reader for petdex.bubble.presentation.v1. It accepts
+ * exactly the ordinary JSON value grammar and deliberately has no file or
+ * network surface; the caller has already capped the payload at 64 KiB. */
+struct BubbleJsonValue {
+    enum Kind { kNull, kBool, kNumber, kString, kArray, kObject } kind = kNull;
+    bool boolean = false;
+    double number = 0;
+    uint64_t integer = 0;
+    bool integer_valid = false;
+    std::string string;
+    std::vector<BubbleJsonValue> array;
+    std::map<std::string, BubbleJsonValue> object;
+};
+
+class BubbleJsonParser {
+public:
+    BubbleJsonParser(const char *bytes, size_t length) : current_(bytes), end_(bytes + length) {}
+
+    bool parse(BubbleJsonValue *out) {
+        if (!out || !value(out, 0)) return false;
+        whitespace();
+        return current_ == end_;
+    }
+
+private:
+    const char *current_;
+    const char *end_;
+
+    void whitespace() {
+        while (current_ < end_ && (*current_ == ' ' || *current_ == '\t' || *current_ == '\r' || *current_ == '\n')) ++current_;
+    }
+
+    bool take(char wanted) {
+        whitespace();
+        if (current_ >= end_ || *current_ != wanted) return false;
+        ++current_;
+        return true;
+    }
+
+    bool literal(const char *word) {
+        whitespace();
+        size_t length = strlen(word);
+        if ((size_t)(end_ - current_) < length || memcmp(current_, word, length) != 0) return false;
+        current_ += length;
+        return true;
+    }
+
+    static void appendUtf8(std::string *out, unsigned codepoint) {
+        if (codepoint <= 0x7f) out->push_back((char)codepoint);
+        else if (codepoint <= 0x7ff) {
+            out->push_back((char)(0xc0 | (codepoint >> 6)));
+            out->push_back((char)(0x80 | (codepoint & 0x3f)));
+        } else if (codepoint <= 0xffff) {
+            out->push_back((char)(0xe0 | (codepoint >> 12)));
+            out->push_back((char)(0x80 | ((codepoint >> 6) & 0x3f)));
+            out->push_back((char)(0x80 | (codepoint & 0x3f)));
+        } else {
+            out->push_back((char)(0xf0 | (codepoint >> 18)));
+            out->push_back((char)(0x80 | ((codepoint >> 12) & 0x3f)));
+            out->push_back((char)(0x80 | ((codepoint >> 6) & 0x3f)));
+            out->push_back((char)(0x80 | (codepoint & 0x3f)));
+        }
+    }
+
+    bool hex4(unsigned *out) {
+        if ((size_t)(end_ - current_) < 4) return false;
+        unsigned value = 0;
+        for (int index = 0; index < 4; ++index) {
+            char ch = *current_++;
+            value <<= 4;
+            if (ch >= '0' && ch <= '9') value |= (unsigned)(ch - '0');
+            else if (ch >= 'a' && ch <= 'f') value |= (unsigned)(ch - 'a' + 10);
+            else if (ch >= 'A' && ch <= 'F') value |= (unsigned)(ch - 'A' + 10);
+            else return false;
+        }
+        *out = value;
+        return true;
+    }
+
+    bool text(std::string *out) {
+        if (!take('"')) return false;
+        out->clear();
+        while (current_ < end_) {
+            unsigned char ch = (unsigned char)*current_++;
+            if (ch == '"') return true;
+            if (ch < 0x20) return false;
+            if (ch != '\\') {
+                out->push_back((char)ch);
+                continue;
+            }
+            if (current_ >= end_) return false;
+            char escape = *current_++;
+            switch (escape) {
+                case '"': out->push_back('"'); break;
+                case '\\': out->push_back('\\'); break;
+                case '/': out->push_back('/'); break;
+                case 'b': out->push_back('\b'); break;
+                case 'f': out->push_back('\f'); break;
+                case 'n': out->push_back('\n'); break;
+                case 'r': out->push_back('\r'); break;
+                case 't': out->push_back('\t'); break;
+                case 'u': {
+                    unsigned codepoint = 0;
+                    if (!hex4(&codepoint)) return false;
+                    if (codepoint >= 0xd800 && codepoint <= 0xdbff) {
+                        if ((size_t)(end_ - current_) < 2 || current_[0] != '\\' || current_[1] != 'u') return false;
+                        current_ += 2;
+                        unsigned low = 0;
+                        if (!hex4(&low) || low < 0xdc00 || low > 0xdfff) return false;
+                        codepoint = 0x10000 + ((codepoint - 0xd800) << 10) + (low - 0xdc00);
+                    } else if (codepoint >= 0xdc00 && codepoint <= 0xdfff) return false;
+                    appendUtf8(out, codepoint);
+                    break;
+                }
+                default: return false;
+            }
+        }
+        return false;
+    }
+
+    bool numeric(BubbleJsonValue *out) {
+        whitespace();
+        const char *start = current_;
+        if (current_ < end_ && *current_ == '-') ++current_;
+        if (current_ >= end_) return false;
+        if (*current_ == '0') ++current_;
+        else {
+            if (*current_ < '1' || *current_ > '9') return false;
+            while (current_ < end_ && *current_ >= '0' && *current_ <= '9') ++current_;
+        }
+        bool integral = true;
+        if (current_ < end_ && *current_ == '.') {
+            integral = false;
+            ++current_;
+            if (current_ >= end_ || *current_ < '0' || *current_ > '9') return false;
+            while (current_ < end_ && *current_ >= '0' && *current_ <= '9') ++current_;
+        }
+        if (current_ < end_ && (*current_ == 'e' || *current_ == 'E')) {
+            integral = false;
+            ++current_;
+            if (current_ < end_ && (*current_ == '+' || *current_ == '-')) ++current_;
+            if (current_ >= end_ || *current_ < '0' || *current_ > '9') return false;
+            while (current_ < end_ && *current_ >= '0' && *current_ <= '9') ++current_;
+        }
+        std::string token(start, current_);
+        char *after = nullptr;
+        out->number = strtod(token.c_str(), &after);
+        if (!after || *after != 0 || !std::isfinite(out->number)) return false;
+        out->kind = BubbleJsonValue::kNumber;
+        if (integral && token[0] != '-') {
+            char *integer_after = nullptr;
+            unsigned long long integer = strtoull(token.c_str(), &integer_after, 10);
+            if (integer_after && *integer_after == 0) {
+                out->integer = (uint64_t)integer;
+                out->integer_valid = true;
+            }
+        }
+        return true;
+    }
+
+    bool value(BubbleJsonValue *out, unsigned depth) {
+        if (depth > 20) return false;
+        whitespace();
+        if (current_ >= end_) return false;
+        if (*current_ == '"') {
+            out->kind = BubbleJsonValue::kString;
+            return text(&out->string);
+        }
+        if (*current_ == '{') {
+            out->kind = BubbleJsonValue::kObject;
+            if (!take('{')) return false;
+            whitespace();
+            if (current_ < end_ && *current_ == '}') { ++current_; return true; }
+            while (true) {
+                std::string key;
+                BubbleJsonValue child;
+                if (!text(&key) || !take(':') || !value(&child, depth + 1)) return false;
+                out->object.emplace(std::move(key), std::move(child));
+                whitespace();
+                if (current_ < end_ && *current_ == '}') { ++current_; return true; }
+                if (!take(',')) return false;
+            }
+        }
+        if (*current_ == '[') {
+            out->kind = BubbleJsonValue::kArray;
+            if (!take('[')) return false;
+            whitespace();
+            if (current_ < end_ && *current_ == ']') { ++current_; return true; }
+            while (true) {
+                BubbleJsonValue child;
+                if (!value(&child, depth + 1)) return false;
+                out->array.push_back(std::move(child));
+                whitespace();
+                if (current_ < end_ && *current_ == ']') { ++current_; return true; }
+                if (!take(',')) return false;
+            }
+        }
+        if (*current_ == 't' && literal("true")) { out->kind = BubbleJsonValue::kBool; out->boolean = true; return true; }
+        if (*current_ == 'f' && literal("false")) { out->kind = BubbleJsonValue::kBool; return true; }
+        if (*current_ == 'n' && literal("null")) { out->kind = BubbleJsonValue::kNull; return true; }
+        return numeric(out);
+    }
+};
+
+static const BubbleJsonValue *bubbleJsonMember(const BubbleJsonValue &object, const char *name) {
+    if (object.kind != BubbleJsonValue::kObject) return nullptr;
+    auto found = object.object.find(name);
+    return found == object.object.end() ? nullptr : &found->second;
+}
+
+static double bubbleJsonNumber(const BubbleJsonValue &object, const char *name, double fallback = 0) {
+    const BubbleJsonValue *value = bubbleJsonMember(object, name);
+    return value && value->kind == BubbleJsonValue::kNumber ? value->number : fallback;
+}
+
+static uint64_t bubbleJsonInteger(const BubbleJsonValue &object, const char *name, uint64_t fallback = 0) {
+    const BubbleJsonValue *value = bubbleJsonMember(object, name);
+    return value && value->kind == BubbleJsonValue::kNumber && value->integer_valid ? value->integer : fallback;
+}
+
+static bool bubbleJsonBool(const BubbleJsonValue &object, const char *name, bool fallback = false) {
+    const BubbleJsonValue *value = bubbleJsonMember(object, name);
+    return value && value->kind == BubbleJsonValue::kBool ? value->boolean : fallback;
+}
+
+static std::string bubbleJsonString(const BubbleJsonValue &object, const char *name) {
+    const BubbleJsonValue *value = bubbleJsonMember(object, name);
+    return value && value->kind == BubbleJsonValue::kString ? value->string : std::string();
+}
+
+static BubbleFrame bubbleJsonFrame(const BubbleJsonValue &object) {
+    BubbleFrame frame;
+    frame.x = (float)bubbleJsonNumber(object, "x");
+    frame.y = (float)bubbleJsonNumber(object, "y");
+    frame.w = (float)bubbleJsonNumber(object, "w");
+    frame.h = (float)bubbleJsonNumber(object, "h");
+    return frame;
+}
+
+static BubbleGlass bubbleJsonGlass(const BubbleJsonValue &object) {
+    BubbleGlass glass;
+    glass.identity = bubbleJsonInteger(object, "id");
+    glass.frame = bubbleJsonFrame(object);
+    glass.alpha = (float)bubbleJsonNumber(object, "alpha", 1);
+    glass.radius = (float)bubbleJsonNumber(object, "radius", 14);
+    glass.state = (int)bubbleJsonInteger(object, "state");
+    glass.interaction = (int)bubbleJsonInteger(object, "interaction");
+    glass.materialization = (int)bubbleJsonInteger(object, "materialization", 2);
+    glass.dark = bubbleJsonBool(object, "dark");
+    glass.high_contrast = bubbleJsonBool(object, "high_contrast");
+    return glass;
+}
+
+static std::vector<BubbleLine> bubbleJsonLines(const BubbleJsonValue *array) {
+    std::vector<BubbleLine> lines;
+    if (!array || array->kind != BubbleJsonValue::kArray) return lines;
+    for (const BubbleJsonValue &item : array->array) {
+        if (item.kind != BubbleJsonValue::kObject || lines.size() >= 3) continue;
+        BubbleLine line;
+        line.text = bubbleJsonString(item, "text");
+        const BubbleJsonValue *frame = bubbleJsonMember(item, "frame");
+        if (frame) line.frame = bubbleJsonFrame(*frame);
+        lines.push_back(std::move(line));
+    }
+    return lines;
+}
+
+static bool bubbleJsonCard(const BubbleJsonValue &object, BubbleCardPresentation *card) {
+    const BubbleJsonValue *glass = bubbleJsonMember(object, "glass");
+    if (!card || !glass || glass->kind != BubbleJsonValue::kObject) return false;
+    card->glass = bubbleJsonGlass(*glass);
+    card->content_alpha = (float)bubbleJsonNumber(object, "content_alpha", 1);
+    card->metadata_alpha = (float)bubbleJsonNumber(object, "metadata_alpha", 1);
+    card->nested_alpha = (float)bubbleJsonNumber(object, "nested_alpha");
+    card->agent = bubbleJsonString(object, "agent");
+    card->hostname = bubbleJsonString(object, "hostname");
+    card->project = bubbleJsonString(object, "project");
+    card->title = bubbleJsonString(object, "title");
+    card->accessibility_label = bubbleJsonString(object, "accessibility_label");
+    card->accessibility_value = bubbleJsonString(object, "accessibility_value");
+    card->accessibility_role = (int)bubbleJsonInteger(object, "accessibility_role");
+    card->action_available = bubbleJsonBool(object, "action_available");
+    card->messages = bubbleJsonLines(bubbleJsonMember(object, "messages"));
+    card->nested = bubbleJsonLines(bubbleJsonMember(object, "nested"));
+    const char *frame_names[] = { "metadata_frame", "metadata_left_frame", "metadata_right_frame", "title_frame", "status_frame" };
+    BubbleFrame *frames[] = { &card->metadata_frame, &card->metadata_left_frame, &card->metadata_right_frame, &card->title_frame, &card->status_frame };
+    for (size_t index = 0; index < 5; ++index) {
+        const BubbleJsonValue *frame = bubbleJsonMember(object, frame_names[index]);
+        if (frame) *frames[index] = bubbleJsonFrame(*frame);
+    }
+    card->action_fade_start = (float)bubbleJsonNumber(object, "action_fade_start");
+    card->action_fade_alpha = (float)bubbleJsonNumber(object, "action_fade_alpha");
+    card->metadata_font_size = (float)bubbleJsonNumber(object, "metadata_font_size", 10);
+    card->title_font_size = (float)bubbleJsonNumber(object, "title_font_size", 16);
+    card->message_font_size = (float)bubbleJsonNumber(object, "message_font_size", 12);
+    card->nested_font_size = (float)bubbleJsonNumber(object, "nested_font_size", 10);
+    card->busy = bubbleJsonBool(object, "busy");
+    card->reduce_motion = bubbleJsonBool(object, "reduce_motion");
+    card->shimmer_phase = (float)bubbleJsonNumber(object, "shimmer_phase");
+    return card->glass.identity != 0 && card->glass.frame.w > 0 && card->glass.frame.h > 0;
+}
