# petdex env vars.
#
# TWO SUPPORTED PATHS to run locally:
#
#   1. bun run dev:docker   - Postgres + Redis in containers + shared OSS Clerk.
#                             Good for testing DB queries, auth flows, or anything
#                             that touches a real backend. Defaults are committed
#                             in .env.dev — copy any value here only if you want
#                             to override it for yourself.
#
#   2. bun run dev          - your own everything. For maintainers.
#                             Fill in the values below from your private accounts.
#
# Anything you set in .env.local wins over .env.dev. Most contributors
# never need to touch this file.

# Core
DATABASE_URL=

# Clerk (frontend public, backend secret)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE=
PETDEX_MANIFEST_V1_URL=
PETDEX_MANIFEST_V1_SNAPSHOT_KEY=
PETDEX_MANIFEST_V2_URL=
PETDEX_MANIFEST_V2_SNAPSHOT_KEY=
# PETDEX_COLLECTION_PREVIEWS_URL is deliberately absent: nothing reads it —
# the snapshot pipeline only keys off PETDEX_COLLECTION_PREVIEWS_SNAPSHOT_KEY.
PETDEX_COLLECTION_PREVIEWS_SNAPSHOT_KEY=

# Lightweight animated card previews (cropped idle-row strip per pet).
# Off by default: only flip to "true" after running `bun previews:snapshot:apply`
# so cards never point at a preview that doesn't exist yet in R2.
NEXT_PUBLIC_PETDEX_PET_PREVIEWS_ENABLED=

# AI / similarity / review / autotag / sound
# The automated review, tagging and sound paths use AI SDK model strings
# ("openai/gpt-5-mini") that the SDK resolves through the Vercel AI Gateway
# provider, which reads only this key — a bare OPENAI_API_KEY does not make
# them work (see AGENTS.md).
AI_GATEWAY_API_KEY=
ELEVENLABS_API_KEY=
FFMPEG_BIN=
# `AI_API_KEY` (or `OPENAI_API_KEY`) enables the optional moderation checks
# in `src/lib/edit-policy.ts` only; they default to a no-moderation path
# when unset, and `EDIT_AI_MODERATION_ENABLED=false` disables them without
# removing the key. The WeChat QR validator reads OPENAI_API_KEY directly
# but currently has no caller (dead code per AGENTS.md).
AI_API_KEY=
EDIT_AI_MODERATION_ENABLED=

# Runtime switches read by src/ but not needed for a standard setup.
# `PETDEX_MOCK_AUTH=1` swaps @clerk/nextjs for a fixed mock user (see
# src/lib/mock/); the deploy compose sets it so a self-hosted stack runs
# without Clerk credentials — never enable it on a network-reachable host.
# `PETDEX_MOCK=1` serves the in-memory mock DB. `PETDEX_STANDALONE=1`
# switches next.config to the standalone output the Dockerfile builds with.
# `PETDEX_REVIEW_DB=runtime` makes the review path skip side effects
# (notifications/emails). `PETDEX_DISABLE_NEXT_CACHE=1` bypasses the
# next/data-cache wrapper when chasing stale reads.
PETDEX_MOCK_AUTH=
PETDEX_MOCK=
PETDEX_STANDALONE=
PETDEX_REVIEW_DB=
PETDEX_DISABLE_NEXT_CACHE=

# Redis / rate-limit / cache
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: explicit per-deployment secret used to hash IPs in the
# /api/telemetry/event rate limiter. If unset, we derive from
# UPSTASH_REDIS_REST_TOKEN (also deploy-stable). The route throws at
# module load in production if NEITHER is set, since per-process
# fallbacks would multiply the 60/min ingestion limit by the number
# of active serverless instances.
TELEMETRY_RATELIMIT_SECRET=
PETDEX_ROUTE_COST_SECRET=
PETDEX_ROUTE_COST_SAMPLE_RATE=

# Shared secret for POST /api/revalidate. External writers that share the
# DB/Upstash (admin.petdex.dev) call it to flush this app's Next data
# cache tags after approve/reject/edit. Must match the admin app's value.
PETDEX_REVALIDATE_SECRET=

# Optional: lets /api/revalidate also purge the Cloudflare edge cache for
# pet URLs. Cloudflare fronts petdex.dev with a cache-everything rule that
# holds 404/500 HTML for ~1h after the origin is fixed. Token needs
# Zone.Cache Purge on the petdex.dev zone.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_PURGE_TOKEN=

# Email notifications
RESEND_API_KEY=
RESEND_FROM=
PETDEX_OWNER_EMAIL=
PETDEX_ADMIN_NOTIFY_EMAIL=
# Signing secret for the Resend delivery webhook. Unset, `/api/webhooks/resend`
# answers 500 `resend_webhook_secret_missing` on every delivery, so bounce and
# complaint events never land and Resend marks the endpoint as failing.
RESEND_WEBHOOK_SECRET=

# Admin
PETDEX_ADMIN_USER_IDS=
NEXT_PUBLIC_PETDEX_ADMIN_USER_IDS=
PETDEX_ADMIN_URL=https://admin.petdex.dev
NEXT_PUBLIC_PETDEX_ADMIN_URL=https://admin.petdex.dev

# Optional app URLs
PETDEX_ALL_PETS_PACK_URL=
# Vercel sets these on the deployment itself; the CSRF origin check reads them
# to accept the deployment's own host. Only needed if you override them.
VERCEL_URL=
VERCEL_BRANCH_URL=
VERCEL_PROJECT_PRODUCTION_URL=
PETDEX_URL=

# Community
# Enables the Discord CTA and /community page when set.
NEXT_PUBLIC_DISCORD_INVITE_URL=
# Enables the zh-only WeChat CTA when set to 1. Requires the Aliyun OSS
# server envs below because the QR is served through /api/wechat-qr.
NEXT_PUBLIC_WECHAT_COMMUNITY_ENABLED=

# Sticker explorer. Enables /stickers/<slug> and adds its collections to
# sitemap.xml; the header's "reactions" link appears to match. Unset, the route
# 404s and no sticker entry is written.
# STICKER_EXPLORER_ENABLED=1
# Renders the built-in "claude" collection without a database, for local
# preview. It drives the page and the header link only — the sitemap entries
# come from STICKER_EXPLORER_ENABLED, so a demo build lists none.
# STICKER_EXPLORER_DEMO=1
# Disables the explorer when set, even if STICKER_EXPLORER_ENABLED is also set.
# STICKER_EXPORT_DISABLED=1

# Aliyun OSS credentials for /api/wechat-qr and QR rotation.
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_REGION=

# CLI / script-related
CLERK_CLI_ISSUER=
PETDEX_CLERK_APP=
PETDEX_CLERK_INSTANCE=
CLERK_ISSUER=
CLERK_OAUTH_CLIENT_ID=
# Served to the CLI by `/api/cli/auth-config` so `petdex login` targets the
# right OAuth app. Both fall back to the production values when unset, so a
# self-hosted instance must set them to avoid sending its users to petdex.dev.
CLERK_CLI_CLIENT_ID=
CLERK_CLI_SCOPES=
